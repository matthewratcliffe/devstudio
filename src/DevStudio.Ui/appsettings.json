{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Orchestrator": {
    "DataPath": "/data",
    "RepositoriesPath": "/data/repos",
    "WorktreesPath": "/data/worktrees",
    "ScratchPath": "/data/scratch",
    "HomePath": "/home/orchestrator",
    "ClaudeExecutable": "claude",
    "CodexExecutable": "codex",
    "OpencodeBaseUrl": "http://localhost:4096",
    "GitExecutable": "git",
    "GitHubCliExecutable": "gh",
    "MaxConcurrentSessions": 6,
    "TurnTimeoutMinutes": 60,
    "SchedulerTickSeconds": 20,
    "SessionAutoArchiveHours": 24,
    "PruneEphemeralWorktrees": false
  }
}
