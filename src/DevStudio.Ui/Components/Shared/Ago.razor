@*
    How long ago something happened, in words while that reads better than a date, and after that
    the date itself — in the reader's timezone, not the container's.
*@

@if (DateTimeOffset.UtcNow - Value is { TotalHours: < 24 } delta)
{
    @(delta switch
    {
        { TotalSeconds: < 60 } => "just now",
        { TotalMinutes: < 60 } => $"{(int)delta.TotalMinutes}m ago",
        _ => $"{(int)delta.TotalHours}h ago",
    })
}
else
{
    <LocalTime Value="@Value" Format="date" />
}

@code {
    [Parameter, EditorRequired] public DateTimeOffset Value { get; set; }
}
