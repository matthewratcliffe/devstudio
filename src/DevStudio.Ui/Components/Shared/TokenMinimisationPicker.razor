@* Which token-saving tactics are in force, for an agent or for one conversation. *@

@if (Inherited is { } inherited)
{
    <label class="check">
        <input type="checkbox" checked="@(Value is null)" disabled="@Disabled"
               @onchange="e => FollowAsync(e.Value is true, inherited)" />
        <span>Follow the agent (@TokenMinimisation.Describe(inherited))</span>
    </label>
}

@foreach (var tactic in TokenMinimisation.All)
{
    <label class="check" title="@tactic.Instruction">
        <input type="checkbox" checked="@TokenMinimisation.Has(Effective, tactic.Flag)"
               disabled="@(Disabled || Following)"
               @onchange="e => ToggleAsync(tactic.Flag, e.Value is true)" />
        <span>
            @tactic.Label
            <span class="hint" style="display:block">@tactic.Hint</span>
        </span>
    </label>
}

<div class="mono-dim">
    @if (Effective == TokenTactics.None)
    {
        <text>Nothing switched on: the agent works however the CLI normally would.</text>
    }
    else
    {
        <text>
            @TokenMinimisation.Describe(Effective) — sent as a Token minimisation section of the
            instructions, so they steer how the work is carried out rather than what it is.
        </text>
    }
</div>

@code {
    /// <summary>
    /// The selection being edited. Null is only meaningful alongside <see cref="Inherited"/>, where
    /// it means the conversation has made no choice of its own and follows the agent.
    /// </summary>
    [Parameter] public TokenTactics? Value { get; set; }

    [Parameter] public EventCallback<TokenTactics?> ValueChanged { get; set; }

    /// <summary>
    /// The agent's selection, when this is editing a conversation's override of it. Null on the
    /// agent's own form, where there is nothing above it to inherit from.
    /// </summary>
    [Parameter] public TokenTactics? Inherited { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private bool Following => Inherited is not null && Value is null;

    /// <summary>What is actually in force: the override when there is one, otherwise the agent's.</summary>
    private TokenTactics Effective => Value ?? Inherited ?? TokenTactics.None;

    /// <summary>
    /// Breaking away from the agent starts from what the agent already had rather than from nothing,
    /// so a single tick does not silently switch every tactic off.
    /// </summary>
    private Task FollowAsync(bool follow, TokenTactics inherited) =>
        EmitAsync(follow ? null : inherited);

    private Task ToggleAsync(TokenTactics tactic, bool on) =>
        EmitAsync(TokenMinimisation.With(Effective, tactic, on));

    private async Task EmitAsync(TokenTactics? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
