@using System.Reflection
@inject IReleaseChecker Releases
<nav class="sidebar @(Open ? "open" : "")">
    <a class="brand" href="/">
        <span class="brand-mark">&gt;_</span>
        <span class="brand-name">
            devStudio
            <span>orchestrator</span>
        </span>
    </a>

    <div class="nav-group">
        <div class="nav-heading">Run</div>
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <span class="ico">◈</span> Dashboard
        </NavLink>
        <NavLink class="nav-link" href="/quick-chat" @onclick="OnNavigate">
            <span class="ico">💬</span> New chat
        </NavLink>
        <NavLink class="nav-link" href="/sessions" @onclick="OnNavigate">
            <span class="ico">▤</span> Sessions
            @if (LiveCount > 0)
            {
                <span class="count">@LiveCount</span>
            }
        </NavLink>
        <NavLink class="nav-link" href="/queues" @onclick="OnNavigate">
            <span class="ico">▦</span> Queues
            @if (QueuedCount > 0)
            {
                <span class="count">@QueuedCount</span>
            }
        </NavLink>
        <NavLink class="nav-link" href="/projects" @onclick="OnNavigate">
            <span class="ico">▣</span> Projects
        </NavLink>
        <NavLink class="nav-link" href="/images" @onclick="OnNavigate">
            <span class="ico">▩</span> Images
        </NavLink>
        <NavLink class="nav-link" href="/notifications" @onclick="OnNavigate">
            <span class="ico">🔔</span> Notifications
            @if (NotificationCount > 0)
            {
                <span class="count">@NotificationCount</span>
            }
        </NavLink>
        <NavLink class="nav-link" href="/terminal" @onclick="OnNavigate">
            <span class="ico">❯_</span> Terminal
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-heading">Build</div>
        <NavLink class="nav-link" href="/agents" @onclick="OnNavigate">
            <span class="ico">✦</span> Agents
        </NavLink>
        <NavLink class="nav-link" href="/workflows" @onclick="OnNavigate">
            <span class="ico">⇶</span> Workflows
        </NavLink>
        <NavLink class="nav-link" href="/schedules" @onclick="OnNavigate">
            <span class="ico">⏱</span> Schedules
        </NavLink>
        <NavLink class="nav-link" href="/skills" @onclick="OnNavigate">
            <span class="ico">◆</span> Skills
        </NavLink>
        <NavLink class="nav-link" href="/standards" @onclick="OnNavigate">
            <span class="ico">§</span> Standards
        </NavLink>
        <NavLink class="nav-link" href="/settings" @onclick="OnNavigate">
            <span class="ico">⚙</span> Settings
        </NavLink>
        <NavLink class="nav-link" href="/team-settings" @onclick="OnNavigate">
            <span class="ico">⛬</span> Team settings
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-heading">Connect</div>
        <NavLink class="nav-link" href="/repositories" @onclick="OnNavigate">
            <span class="ico">⑂</span> Repositories
        </NavLink>
        <NavLink class="nav-link" href="/cli-providers" @onclick="OnNavigate">
            <span class="ico">⌘</span> CLI providers
        </NavLink>
        <NavLink class="nav-link" href="/mcp-servers" @onclick="OnNavigate">
            <span class="ico">⚯</span> MCP servers
        </NavLink>
        <NavLink class="nav-link" href="/providers" @onclick="OnNavigate">
            <span class="ico">⚿</span> Logins
        </NavLink>
        <NavLink class="nav-link" href="/remote-instances" @onclick="OnNavigate">
            <span class="ico">⇄</span> Remote instances
        </NavLink>
        <NavLink class="nav-link" href="/users" @onclick="OnNavigate">
            <span class="ico">☗</span> Users
        </NavLink>
    </div>

    <div class="nav-foot">
        <span class="build" title="@Version">v@(Version)</span>

        @if (_release is { UpdateAvailable: true })
        {
            <a class="build-update" href="@_release.Url" target="_blank" rel="noopener noreferrer"
               title="Pull the new image to upgrade">@(_release.Latest) available</a>
        }
    </div>
</nav>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int LiveCount { get; set; }

    /// <summary>Queue items waiting or running, across every queue.</summary>
    [Parameter] public int QueuedCount { get; set; }

    /// <summary>Active notifications, shared across every viewer.</summary>
    [Parameter] public int NotificationCount { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private ReleaseStatus? _release;

    /// <summary>
    /// The informational version, which is the release tag a CI build was stamped with. The assembly
    /// version is the fallback, and reads 1.0.0 on a build nobody gave a version to.
    /// </summary>
    private static string Version { get; } =
        ReleaseVersion.Parse(typeof(NavMenu).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion)?.ToString()
        ?? typeof(NavMenu).Assembly.GetName().Version?.ToString(3)
        ?? "1.0.0";

    protected override void OnInitialized()
    {
        // Deliberately not awaited: the answer is cached for hours and the nav should never wait on
        // a network call to render.
        _ = ShowReleaseAsync();
    }

    private async Task ShowReleaseAsync()
    {
        _release = await Releases.CheckAsync();

        if (_release.UpdateAvailable)
            await InvokeAsync(StateHasChanged);
    }
}
