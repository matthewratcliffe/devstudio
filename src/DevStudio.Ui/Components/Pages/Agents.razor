@page "/agents"
@inject IEntityStore<Agent> AgentStore
@inject IEntityStore<GlobalSettings> SettingsStore
@inject IEntityStore<McpServer> McpStore
@inject IEntityStore<Project> ProjectStore
@inject IEntityStore<CliProvider> CliProviderStore
@inject ISessionManager Sessions
@inject NavigationManager Nav
@inject ExecutionTargets Targets
@using DevStudio.Ui.Services

<PageTitle>Agents · devStudio</PageTitle>

<div class="btn-row" style="margin-bottom:1.2rem">
    <button class="btn btn-primary" @onclick="() => Edit(NewAgent())">New agent</button>
    <span class="mono-dim">Each agent is bound to one CLI. Add as many as you like.</span>
</div>

@foreach (var group in _agents.GroupedByCategory())
{
    @if (group.Key == CategoryGrouping.Uncategorized)
    {
        <div class="grid grid-auto" style="margin-bottom:1.2rem">
            @foreach (var agent in group)
            {
                @AgentCard(agent)
            }
        </div>
    }
    else
    {
        <details class="side-accordion" open style="margin-bottom:1.2rem">
            <summary class="section-tag">@group.Key <span class="mono-dim">(@group.Count())</span></summary>
            <div class="grid grid-auto">
                @foreach (var agent in group)
                {
                    @AgentCard(agent)
                }
            </div>
        </details>
    }
}

@code {
    private RenderFragment AgentCard(Agent agent) => @<div class="card">
        <div class="card-head">
            <h3>@agent.Name</h3>
            <div class="spacer"></div>
            @if (agent.TeamSourcePath is { Length: > 0 } source)
            {
                <span class="pill" title="From the team settings repository: @source">team</span>
            }
            <span class="pill @ProviderCss(agent)">
                <span class="dot"></span>@ProviderLabel(agent)
            </span>
        </div>
        <p class="small">@(string.IsNullOrWhiteSpace(agent.Description) ? "No description." : agent.Description)</p>

        <div class="btn-row" style="margin-bottom:0.7rem">
            <span class="pill">@agent.PermissionMode</span>
            @if (agent.UseWorktree && agent.RepositoryId is not null)
            {
                <span class="pill">worktree</span>
            }
            @if (agent.SkillIds.Count > 0)
            {
                <span class="pill">@agent.SkillIds.Count skills</span>
            }
            @if (agent.McpServerIds.Count > 0)
            {
                <span class="pill">@agent.McpServerIds.Count mcp</span>
            }
            @if (!agent.Enabled)
            {
                <span class="pill pill-red">disabled</span>
            }
        </div>

        <div class="btn-row">
            <button class="btn btn-sm btn-primary" @onclick="() => StartChat(agent)">Chat</button>
            <button class="btn btn-sm" @onclick="() => Edit(agent)">Edit</button>
            <a class="btn btn-sm" href="@HistoryUrl(agent)">History</a>
            <button class="btn btn-sm btn-ghost" @onclick="() => DuplicateAsync(agent)">Duplicate</button>
            <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(agent)">Delete</button>
        </div>
    </div>;
}

@if (_agents.Count == 0)
{
    <div class="empty">
        <div class="big">✦</div>
        No agents yet. Create one to start driving a CLI.
    </div>
}

@if (_editing is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h2>@(_isNew ? "New agent" : _editing.Name)</h2>

            <div class="form-grid">
                <div class="field">
                    <label>Name</label>
                    <input type="text" @bind="_editing.Name" />
                </div>
                <div class="field">
                    <label>Provider</label>
                    <select @bind="_editing.Provider">
                        <option value="@AiProvider.Claude">Claude Code (claude)</option>
                        <option value="@AiProvider.Codex">OpenAI Codex (codex)</option>
                        <option value="@AiProvider.Opencode">OpenCode (opencode)</option>
                        @if (_target.Clis.Any(c => c.CliProviderId is { Length: > 0 }))
                        {
                            <option value="@AiProvider.Custom">Custom CLI…</option>
                        }
                    </select>
                </div>
            </div>

            <RemoteInstancePicker Value="_editing.RemoteInstanceId" ValueChanged="SelectInstanceAsync"
                                  Hint="Where this agent's sessions run. Its repository, login, skills and MCP servers below all come from that machine." />

            @if (_targetError is { Length: > 0 })
            {
                <div class="setting-callout warn">@_targetError</div>
            }

            <div class="form-grid">
                <div class="field">
                    <label>Description</label>
                    <input type="text" @bind="_editing.Description" placeholder="What this agent is for" />
                </div>
                <div class="field">
                    <label>Category</label>
                    <input type="text" @bind="_editing.Category" placeholder="Groups this agent in pick lists" list="agent-categories" />
                    <datalist id="agent-categories">
                        @foreach (var category in _agents.Select(a => a.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@category" />
                        }
                    </datalist>
                </div>
            </div>

            <div class="field">
                <label>System prompt</label>
                <textarea @bind="_editing.SystemPrompt" rows="4"
                          placeholder="Standing instructions applied to every turn."></textarea>
                <span class="hint">Project instructions are layered on top of this when the agent runs in a project.</span>
            </div>

            <div class="field">
                <label>Default first prompt</label>
                <textarea @bind="_editing.DefaultPrompt" rows="3"
                          placeholder="Sent as the opening turn when a session starts without a prompt."></textarea>
                <span class="hint">Fills the first prompt on a new session, and is what scheduled runs send when they carry no prompt of their own.</span>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label>Permission mode</label>
                    <select @bind="_editing.PermissionMode">
                        <option value="@PermissionMode.Default">Default — ask for everything</option>
                        <option value="@PermissionMode.Plan">Plan — read only</option>
                        <option value="@PermissionMode.AcceptEdits">Accept edits</option>
                        <option value="@PermissionMode.Unrestricted">No restrictions</option>
                    </select>
                    <span class="hint">Unattended runs need Accept edits or higher — Default blocks on prompts.</span>
                    @if (_editing.PermissionMode == PermissionMode.Plan && HasMcp(_editing))
                    {
                        <span class="hint" style="color:var(--amber)">
                            Plan mode refuses every MCP tool call, so the servers below will be visible to
                            the agent but unusable. Use Accept edits if it needs them.
                        </span>
                    }
                </div>
                <div class="field">
                    <label>Model</label>
                    <select value="@(_customModel ? "__custom" : _editing.Model ?? string.Empty)"
                            @onchange="e => SetModel(e.Value?.ToString())">
                        <option value="">CLI default</option>
                        @foreach (var model in ModelsFor(_editing))
                        {
                            <option value="@model">@model</option>
                        }
                        <option value="__custom">Something else…</option>
                    </select>
                    @if (_customModel)
                    {
                        <input type="text" @bind="_editing.Model" placeholder="model name passed straight to the CLI" />
                    }
                </div>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label>Project</label>
                    <select @bind="_editing.ProjectId">
                        <option value="">None</option>
                        @foreach (var project in _projects)
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Repository</label>
                    <select value="@(_editing.RepositoryId ?? string.Empty)"
                            @onchange="e => SelectRepositoryAsync(e.Value?.ToString())">
                        <option value="">None (scratch or project folder)</option>
                        @foreach (var repository in _target.Repositories)
                        {
                            <option value="@repository.Id">@repository.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (_editing.Provider == AiProvider.Custom)
            {
                <div class="field">
                    <label>Which CLI</label>
                    <select @bind="_editing.CliProviderId">
                        <option value="">Pick one</option>
                        @foreach (var cli in _target.Clis.Where(c => c.CliProviderId is { Length: > 0 }))
                        {
                            <option value="@cli.CliProviderId">@cli.DisplayName</option>
                        }
                    </select>
                    <span class="hint">
                        @(_editing.RemoteInstanceId is null
                            ? "Defined on the CLI providers page."
                            : "Defined on that instance's own CLI providers page.")
                    </span>
                </div>
            }

            <div class="field">
                <label>Thinking level</label>
                <select value="@(_editing.Effort ?? string.Empty)" @onchange="e => _editing.Effort = Blank(e.Value?.ToString())">
                    <option value="">CLI default</option>
                    @foreach (var effort in EffortsFor(_editing))
                    {
                        <option value="@effort">@effort</option>
                    }
                </select>
                <span class="hint">
                    @(_editing.Provider == AiProvider.Claude
                        ? "Passed as --effort."
                        : _editing.Provider == AiProvider.Codex
                            ? "Passed as model_reasoning_effort."
                            : "Uses the thinking arguments configured for this CLI.")
                </span>
            </div>

            <div class="field">
                <label class="check" style="margin:0">
                    <input type="checkbox" checked="@_handover" @onchange="ToggleHandover" />
                    <span>Open on a different model, then hand over</span>
                </label>
                <span class="hint">
                    The first turns of a session are where the plan is made, and where a stronger model
                    is worth paying for. The turns after it are usually carrying that plan out.
                </span>
            </div>

            @if (_handover)
            {
                <div class="form-grid">
                    <div class="field">
                        <label>Opening model</label>
                        <select value="@(_editing.OpeningModel ?? string.Empty)"
                                @onchange="e => _editing.OpeningModel = Blank(e.Value?.ToString())">
                            <option value="">Same as above</option>
                            @foreach (var model in ModelsFor(_editing))
                            {
                                <option value="@model">@model</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Opening thinking level</label>
                        <select value="@(_editing.OpeningEffort ?? string.Empty)"
                                @onchange="e => _editing.OpeningEffort = Blank(e.Value?.ToString())">
                            <option value="">Same as above</option>
                            @foreach (var effort in EffortsFor(_editing))
                            {
                                <option value="@effort">@effort</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>For the first</label>
                        <input type="number" min="1" max="99" @bind="_editing.OpeningTurns" />
                        <span class="hint">turns, counting the one that starts the session.</span>
                    </div>
                </div>
                <div class="mono-dim">@HandoverSummary(_editing)</div>
            }

            <div class="field">
                <label>Account</label>
                <select @bind="_editing.AccountId">
                    <option value="">Default for this CLI</option>
                    @foreach (var account in AccountsForProvider())
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </select>
                <span class="hint">A project's own choice wins over this when the session runs in one.</span>
            </div>

            <div class="field">
                <label>Fallback account</label>
                <select @bind="_editing.FallbackAccountId">
                    <option value="">Automatic fallback</option>
                    @foreach (var account in AccountsForProvider().Where(a => a.Id != _editing.AccountId))
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </select>
                <span class="hint">Used when the primary account fails before producing an answer.</span>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label>Base branch</label>
                    @if (_branches.Count > 0)
                    {
                        <select value="@(_editing.BaseBranch ?? string.Empty)"
                                @onchange="e => _editing.BaseBranch = Blank(e.Value?.ToString())">
                            <option value="">Repository default (@DefaultBranch)</option>
                            @foreach (var branch in _branches)
                            {
                                <option value="@branch">@branch</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" @bind="_editing.BaseBranch"
                               placeholder="@BranchPlaceholder"
                               disabled="@(_editing.RepositoryId is null)" />
                    }
                </div>
                <div class="field">
                    <label>Extra CLI arguments</label>
                    <input type="text" @bind="_editing.ExtraArguments" placeholder="--add-dir /data/shared" />
                </div>
            </div>

            <div class="check">
                <input type="checkbox" id="worktree" @bind="_editing.UseWorktree" />
                <label for="worktree" style="text-transform:none;letter-spacing:0">Give every session its own git worktree</label>
            </div>
            <div class="check">
                <input type="checkbox" id="enabled" @bind="_editing.Enabled" />
                <label for="enabled" style="text-transform:none;letter-spacing:0">Enabled</label>
            </div>

            <div class="divider"></div>

            <div class="section-tag">Token minimisation</div>
            <p class="mono-dim">
                How this agent should go about the work when tokens are worth saving. Each one is an
                instruction carried in every turn's prompt, not something enforced here, and any chat
                can change the selection for itself while it runs.
            </p>
            <TokenMinimisationPicker Value="_editing.TokenMinimisation"
                                     ValueChanged="v => _editing.TokenMinimisation = v ?? TokenTactics.None" />

            <div class="divider"></div>
            <div class="field">
                <label>Prompting tips</label>
                <select value="@PromptingTipsValue" @onchange="SetPromptingTips">
                    <option value="inherit">Follow application setting</option>
                    <option value="on">Show tips for this agent</option>
                    <option value="off">Hide tips for this agent</option>
                </select>
                <span class="hint">Tips teach clearer, more focused and lower-cost prompting in the chat composer.</span>
            </div>
            <div class="field">
                <label>LLM prompting tips</label>
                <select value="@UseLlmPromptingTipsValue" @onchange="SetUseLlmPromptingTips">
                    <option value="inherit">Follow application setting</option>
                    <option value="on">Use LLM for this agent</option>
                    <option value="off">Use local tips only</option>
                </select>
                <span class="hint">The LLM option adds a tailored tip to answers and uses extra tokens.</span>
            </div>

            <div class="divider"></div>

            <div class="grid grid-2">
                <div>
                    <div class="section-tag">Skills</div>
                    @if (_target.Skills.Count == 0)
                    {
                        <p class="mono-dim">No skills defined on that machine.</p>
                    }
                    @foreach (var skill in _target.Skills)
                    {
                        <div class="check" @key="skill.Id">
                            <input type="checkbox"
                                   @bind:get="_editing.SkillIds.Contains(skill.Id)"
                                   @bind:set="on => Toggle(_editing.SkillIds, skill.Id, on)" />
                            <span>@skill.Name</span>
                        </div>
                    }
                </div>
                <div>
                    <div class="section-tag">MCP servers</div>
                    @if (_target.McpServers.Count == 0)
                    {
                        <p class="mono-dim">No MCP servers registered on that machine.</p>
                    }
                    @foreach (var server in _target.McpServers)
                    {
                        <div class="check" @key="server.Id">
                            <input type="checkbox"
                                   disabled="@server.IsDefault"
                                   @bind:get="_editing.McpServerIds.Contains(server.Id) || server.IsDefault"
                                   @bind:set="on => Toggle(_editing.McpServerIds, server.Id, on)" />
                            <span>@server.Name @(server.IsDefault ? "(always on)" : "")</span>
                        </div>
                    }
                </div>
            </div>

            <div class="divider"></div>
            <div class="btn-row">
                <button class="btn btn-primary" @onclick="SaveAsync">Save agent</button>
                <button class="btn btn-ghost" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<Agent> _agents = [];
    private IReadOnlyList<McpServer> _mcpServers = [];
    private IReadOnlyList<Project> _projects = [];
    private IReadOnlyList<CliProvider> _cliProviders = [];

    /// <summary>
    /// What the machine the agent being edited runs on has to offer. Every picker in the editor
    /// reads from this rather than from the local stores, because a repository, a login, a skill and
    /// an MCP server all exist on one machine and naming one that lives somewhere else would produce
    /// an agent that fails on its first turn.
    /// </summary>
    private RemoteHostConfig _target = RemoteHostConfig.Empty(string.Empty);

    private string? _targetError;
    private TokenTactics _defaultTokenMinimisation = new GlobalSettings().DefaultTokenMinimisation;

    private string PromptingTipsValue => _editing?.PromptingTips switch
    {
        true => "on",
        false => "off",
        _ => "inherit",
    };

    private string UseLlmPromptingTipsValue => _editing?.UseLlmForPromptingTips switch
    {
        true => "on",
        false => "off",
        _ => "inherit",
    };

    private Agent? _editing;
    private bool _isNew;
    private bool _customModel;
    private bool _handover;
    private IReadOnlyList<string> _branches = [];

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Agents", "Who you can talk to, and how they behave");
    }

    private async Task ReloadAsync()
    {
        // Quick-chat agents are created behind the scenes and are not configurable here.
        _agents = (await AgentStore.GetAllAsync()).Where(a => !a.IsQuickChat).ToList();
        _mcpServers = await McpStore.GetAllAsync();
        _projects = await ProjectStore.GetAllAsync();
        _cliProviders = await CliProviderStore.GetAllAsync();
        _defaultTokenMinimisation = (await SettingsStore.GetAsync(GlobalSettings.WellKnownId))?.DefaultTokenMinimisation
                                    ?? _defaultTokenMinimisation;
    }

    private Agent NewAgent() => new() { TokenMinimisation = _defaultTokenMinimisation };

    private void SetPromptingTips(ChangeEventArgs args) =>
        _editing!.PromptingTips = args.Value?.ToString() switch
        {
            "on" => true,
            "off" => false,
            _ => null,
        };

    private void SetUseLlmPromptingTips(ChangeEventArgs args) =>
        _editing!.UseLlmForPromptingTips = args.Value?.ToString() switch
        {
            "on" => true,
            "off" => false,
            _ => null,
        };

    /// <summary>
    /// The CLI the agent is set to, as the machine it runs on describes it. Both model and effort
    /// lists come from there — a remote's Claude may well be a different build with different models
    /// from this one's.
    /// </summary>
    private RemoteCliDescriptor? DescriptorFor(Agent agent) =>
        agent.Provider == AiProvider.Custom
            ? _target.Clis.FirstOrDefault(c => c.CliProviderId == agent.CliProviderId)
            : _target.Clis.FirstOrDefault(c => c.Provider == agent.Provider && c.CliProviderId is null);

    /// <summary>
    /// Logins on the chosen machine that belong to the CLI the agent is set to. The account list
    /// carries its provider in <c>Detail</c>, which is what makes this filterable without a second
    /// round trip.
    /// </summary>
    private IEnumerable<RemoteNamedItem> AccountsForProvider()
    {
        if (_editing is null)
            return [];

        var key = _editing.Provider == AiProvider.Custom
            ? $"Custom:{_editing.CliProviderId}"
            : _editing.Provider.ToString();

        return _target.Accounts.Where(a => a.Detail == key);
    }

    private IReadOnlyList<string> ModelsFor(Agent agent) => DescriptorFor(agent)?.Models ?? [];

    private IReadOnlyList<string> EffortsFor(Agent agent) => DescriptorFor(agent)?.Efforts ?? [];

    private string DefaultBranch =>
        _target.Repositories.FirstOrDefault(r => r.Id == _editing?.RepositoryId)?.Detail ?? "main";

    private string BranchPlaceholder =>
        _editing?.RepositoryId is null ? "pick a repository first" : "loading branches...";

    /// <summary>Loads the branch list so the base branch is picked rather than typed.</summary>
    private async Task SelectRepositoryAsync(string? repositoryId)
    {
        _editing!.RepositoryId = Blank(repositoryId);
        _editing.BaseBranch = null;
        await LoadBranchesAsync();
    }

    private async Task LoadBranchesAsync()
    {
        _branches = [];

        if (_editing?.RepositoryId is not { Length: > 0 } repositoryId)
            return;

        // Asked of whichever machine holds the checkout. The list is a convenience and the field
        // falls back to free text, so an unreachable instance costs nothing here.
        _branches = await Targets.BranchesAsync(_editing.RemoteInstanceId, repositoryId);
    }

    /// <summary>
    /// Reloads everything the editor offers from the machine the agent now points at. Called when
    /// the editor opens and whenever the instance is changed, which is what makes every dependent
    /// picker follow the choice.
    /// </summary>
    private async Task LoadTargetAsync()
    {
        (_target, _targetError) = await Targets.ConfigAsync(_editing?.RemoteInstanceId);
    }

    private async Task SelectInstanceAsync(string? remoteInstanceId)
    {
        if (_editing is null)
            return;

        remoteInstanceId = Blank(remoteInstanceId);

        // Re-selecting the machine it is already on is not a change, and must not cost the agent its
        // repository, login, skills and servers.
        if (remoteInstanceId == _editing.RemoteInstanceId)
            return;

        _editing.RemoteInstanceId = remoteInstanceId;

        // Repositories, logins, skills and MCP servers are all named by ids that belong to one
        // machine. Carrying them over would leave the agent pointing at things that are not there,
        // and the failure would not show up until its first turn.
        _editing.RepositoryId = null;
        _editing.BaseBranch = null;
        _editing.AccountId = null;
        _editing.FallbackAccountId = null;
        _editing.SkillIds.Clear();
        _editing.McpServerIds.Clear();
        _branches = [];

        await LoadTargetAsync();

        // The CLI may not exist over there either.
        if (DescriptorFor(_editing) is null)
        {
            _editing.CliProviderId = null;
            _editing.Model = null;
            _editing.Effort = null;
            _editing.OpeningModel = null;
            _editing.OpeningEffort = null;
        }
    }

    /// <summary>
    /// Turning the handover off clears it rather than leaving a turn count behind that nothing reads,
    /// so what is stored always matches what the form says.
    /// </summary>
    private void ToggleHandover(ChangeEventArgs args)
    {
        _handover = args.Value is true;

        if (_editing is null)
            return;

        if (_handover)
        {
            if (_editing.OpeningTurns <= 0)
                _editing.OpeningTurns = 2;

            return;
        }

        _editing.OpeningTurns = 0;
        _editing.OpeningModel = null;
        _editing.OpeningEffort = null;
    }

    /// <summary>Spells the schedule out, because two model fields and a count do not read as one.</summary>
    private static string HandoverSummary(Agent agent)
    {
        var opening = Describe(agent.OpeningModel, agent.OpeningEffort, agent.Model, agent.Effort);
        var rest = Describe(agent.Model, agent.Effort, null, null);
        var turns = Math.Max(1, agent.OpeningTurns);

        return $"Turn{(turns == 1 ? "" : "s")} 1{(turns == 1 ? "" : $"–{turns}")} on {opening}, everything after on {rest}.";
    }

    private static string Describe(string? model, string? effort, string? fallbackModel, string? fallbackEffort)
    {
        var name = Blank(model) ?? Blank(fallbackModel) ?? "the CLI default";
        var level = Blank(effort) ?? Blank(fallbackEffort);

        return level is null ? name : $"{name} at {level}";
    }

    private void SetModel(string? value)
    {
        if (value == "__custom")
        {
            _customModel = true;
            return;
        }

        _customModel = false;
        _editing!.Model = Blank(value);
    }

    private static string HistoryUrl(Agent agent) =>
        $"/sessions?AgentId={Uri.EscapeDataString(agent.Id)}&Name={Uri.EscapeDataString(agent.Name)}";

    private async Task Edit(Agent agent)
    {
        _isNew = string.IsNullOrWhiteSpace(agent.Name) || _agents.All(a => a.Id != agent.Id);
        // Edit a copy so cancelling leaves the stored agent untouched.
        var editing = Clone(agent);
        _handover = editing.OpeningTurns > 0;
        _branches = [];

        // Fetched before the editor is on screen, not after. Every picker below is built from it,
        // and the skill and MCP ticks are drawn from the list it carries: an editor that opened
        // first and filled its lists in a moment later showed those two sections built against
        // nothing, so an agent's saved skills and servers came up unticked.
        (_target, _targetError) = await Targets.ConfigAsync(editing.RemoteInstanceId);

        _editing = editing;

        // A model that is not in the list is still valid — show it in the free-text box.
        _customModel = !string.IsNullOrWhiteSpace(_editing.Model) && !ModelsFor(_editing).Contains(_editing.Model);

        await LoadBranchesAsync();
    }

    private void Cancel() => _editing = null;

    private async Task SaveAsync()
    {
        if (_editing is null)
            return;

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            Layout.Notify("An agent needs a name.", "err");
            return;
        }

        // Empty selects bind to "", which is not a valid id.
        _editing.ProjectId = Blank(_editing.ProjectId);
        _editing.RepositoryId = Blank(_editing.RepositoryId);
        _editing.AccountId = Blank(_editing.AccountId);
        _editing.CliProviderId = Blank(_editing.CliProviderId);

        if (_editing.Provider == AiProvider.Custom && _editing.CliProviderId is null)
        {
            Layout.Notify("Pick which CLI this agent drives.", "err");
            return;
        }
        _editing.BaseBranch = Blank(_editing.BaseBranch);
        _editing.Model = Blank(_editing.Model);
        _editing.OpeningModel = Blank(_editing.OpeningModel);
        _editing.OpeningEffort = Blank(_editing.OpeningEffort);

        if (_editing.OpeningTurns < 0)
            _editing.OpeningTurns = 0;

        await AgentStore.UpsertAsync(_editing);
        _editing = null;
        await ReloadAsync();
        Layout.Notify("Agent saved.", "ok");
    }

    private async Task DuplicateAsync(Agent agent)
    {
        var copy = Clone(agent);
        copy.Id = Guid.NewGuid().ToString("n");
        copy.Name = agent.Name + " (copy)";
        copy.CreatedAt = DateTimeOffset.UtcNow;
        await AgentStore.UpsertAsync(copy);
        await ReloadAsync();
    }

    private async Task DeleteAsync(Agent agent)
    {
        await AgentStore.DeleteAsync(agent.Id);
        await ReloadAsync();
        Layout.Notify($"Deleted {agent.Name}.", "ok");
    }

    private void StartChat(Agent agent) => Nav.NavigateTo($"/agents/{agent.Id}/chat");

    private static void Toggle(List<string> list, string id, bool on)
    {
        if (on)
        {
            if (!list.Contains(id))
                list.Add(id);
        }
        else
        {
            list.Remove(id);
        }
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private bool HasMcp(Agent agent) =>
        agent.McpServerIds.Count > 0 || _mcpServers.Any(s => s.IsDefault && s.Enabled);

    private string ProviderLabel(Agent agent) => agent.Provider switch
    {
        AiProvider.Custom => _cliProviders.FirstOrDefault(c => c.Id == agent.CliProviderId)?.Name ?? "custom CLI",
        AiProvider.Opencode => "OpenCode",
        _ => agent.Provider.ToString(),
    };

    private static string ProviderCss(Agent agent) => agent.Provider switch
    {
        AiProvider.Claude => "pill-cyan",
        AiProvider.Codex => "pill-magenta",
        AiProvider.Opencode => "pill-green",
        _ => "pill-lime",
    };

    private static Agent Clone(Agent agent) => new()
    {
        Id = agent.Id,
        CreatedAt = agent.CreatedAt,
        Name = agent.Name,
        Description = agent.Description,
        Category = agent.Category,
        Provider = agent.Provider,
        CliProviderId = agent.CliProviderId,
        Model = agent.Model,
        Effort = agent.Effort,
        OpeningModel = agent.OpeningModel,
        OpeningEffort = agent.OpeningEffort,
        OpeningTurns = agent.OpeningTurns,
        SystemPrompt = agent.SystemPrompt,
        DefaultPrompt = agent.DefaultPrompt,
        PermissionMode = agent.PermissionMode,
        TokenMinimisation = agent.TokenMinimisation,
        PromptingTips = agent.PromptingTips,
        UseLlmForPromptingTips = agent.UseLlmForPromptingTips,
        ProjectId = agent.ProjectId,
        AccountId = agent.AccountId,
        FallbackAccountId = agent.FallbackAccountId,
        RemoteInstanceId = agent.RemoteInstanceId,
        RepositoryId = agent.RepositoryId,
        BaseBranch = agent.BaseBranch,
        UseWorktree = agent.UseWorktree,
        SkillIds = [.. agent.SkillIds],
        McpServerIds = [.. agent.McpServerIds],
        Environment = new Dictionary<string, string>(agent.Environment),
        ExtraArguments = agent.ExtraArguments,
        Enabled = agent.Enabled,
        Accent = agent.Accent,
        // Carried even though the editor never shows them: a copy that dropped them would put an
        // agent back on this machine, out of its category, or adrift from the team file it came
        // from, every time somebody opened it to change something else.
        IsQuickChat = agent.IsQuickChat,
        TeamSourcePath = agent.TeamSourcePath,
    };
}
