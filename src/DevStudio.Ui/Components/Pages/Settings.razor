@page "/settings"
@inject IEntityStore<GlobalSettings> SettingsStore
@inject WorkspacePathPolicy PathPolicy

<PageTitle>Settings · devStudio</PageTitle>

<div class="card" style="margin-bottom:1.2rem">
    <div class="section-tag">Workspace security</div>
    <p class="small">
        These controls apply to agent file tools, ACP file callbacks and workspace downloads. The
        secure defaults keep every path inside its assigned workspace and reject symlinks.
    </p>
</div>

<div class="card">
    <div class="field-row">
        <div>
            <label for="validate-paths">Validate workspace paths</label>
            <div class="hint">
                Refuse paths outside the session workspace after normalisation. Disabling this lets
                agents and browser downloads address any path they can reach.
            </div>
        </div>
        <input id="validate-paths" type="checkbox" @bind="_settings.ValidateWorkspacePaths" />
    </div>

    <div class="field-row">
        <div>
            <label for="follow-symlinks">Follow workspace symlinks</label>
            <div class="hint">
                Allow existing symlinks while resolving workspace paths. With validation enabled,
                their final target must still remain inside the workspace.
            </div>
        </div>
        <input id="follow-symlinks" type="checkbox" @bind="_settings.FollowWorkspaceSymlinks" />
    </div>

    @if (!_settings.ValidateWorkspacePaths)
    {
        <div class="card" style="margin-top:1rem;border-color:var(--red,#f56565)">
            <strong>Warning:</strong> path validation is disabled. Agents can read and write outside
            their workspaces.
        </div>
    }
    else if (_settings.FollowWorkspaceSymlinks)
    {
        <div class="card" style="margin-top:1rem;border-color:var(--amber,#f6c85f)">
            Symlinks are enabled. Links to locations outside a workspace are still rejected while
            path validation remains on.
        </div>
    }

    <div class="divider"></div>
    <div class="section-tag">Web tools</div>
    <div class="field-row">
        <div>
            <label for="enable-web-tools">Allow WebFetch and WebSearch</label>
            <div class="hint">
                Grants every agent standing permission to fetch URLs and search the web without being
                asked. Nobody answers permission prompts in a headless session, so leaving this off
                means those two tools never work at all.
            </div>
        </div>
        <input id="enable-web-tools" type="checkbox" @bind="_settings.EnableWebTools" />
    </div>

    <div class="divider"></div>
    <div class="section-tag">Goal tracking</div>
    <div class="field-row">
        <div>
            <label for="enable-goal">Track a goal per session</label>
            <div class="hint">
                Shows the "Goal" field in the chat sidebar, lets agents read and set it over MCP, and
                guesses one after a couple of turns if nobody has set it yet — a guess is always shown
                for confirmation, never adopted automatically.
            </div>
        </div>
        <input id="enable-goal" type="checkbox" @bind="_settings.EnableGoal" />
    </div>

    <div class="divider"></div>
    <div class="section-tag">Token minimisation defaults</div>
    <p class="small">
        These tactics are selected for new agents and quick chats. Existing agents keep their own
        choices, and each chat can override them.
    </p>
    <TokenMinimisationPicker Value="_settings.DefaultTokenMinimisation"
                             ValueChanged="SetDefaultTokenMinimisation" />

    <div class="btn-row" style="margin-top:1.2rem">
        <button class="btn btn-primary" @onclick="SaveAsync">Save settings</button>
        <span class="mono-dim">Workspace controls apply immediately; token defaults apply to new agents and quick chats.</span>
    </div>
</div>

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private GlobalSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsStore.GetAsync(GlobalSettings.WellKnownId) ?? new GlobalSettings();
        PathPolicy.Apply(_settings);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Settings", "Security and application behaviour");
    }

    private async Task SaveAsync()
    {
        await SettingsStore.UpsertAsync(_settings);
        PathPolicy.Apply(_settings);
        Layout.Notify("Settings saved.", "ok");
    }

    private Task SetDefaultTokenMinimisation(TokenTactics? tactics)
    {
        _settings.DefaultTokenMinimisation = tactics ?? TokenTactics.None;
        return Task.CompletedTask;
    }
}
