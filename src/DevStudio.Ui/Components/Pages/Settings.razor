@page "/settings"
@inject IEntityStore<GlobalSettings> SettingsStore
@inject WorkspacePathPolicy PathPolicy

<PageTitle>Settings · devStudio</PageTitle>

<div class="settings-bar">
    <div class="section-tag" style="margin:0">Application settings</div>
    <div class="spacer"></div>
    <span class="save-hint">Workspace controls apply immediately · token defaults apply to new agents and quick chats</span>
    <button class="btn btn-primary" @onclick="SaveAsync">Save settings</button>
</div>

<div class="settings-grid">

    <div class="card">
        <div class="setting-group">
            <div class="setting-group-head">
                <span class="ico">🔒</span>
                <div>
                    <h3 style="margin:0">Workspace security</h3>
                </div>
            </div>
            <p class="small setting-group-desc">
                Applies to agent file tools, ACP file callbacks and workspace downloads. Secure defaults
                keep every path inside its assigned workspace and reject symlinks.
            </p>

            <div class="setting-row">
                <input id="validate-paths" class="switch" type="checkbox" @bind="_settings.ValidateWorkspacePaths" />
                <div class="setting-copy">
                    <label for="validate-paths">Validate workspace paths</label>
                    <div class="hint">
                        Refuse paths outside the session workspace after normalisation. Disabling this lets
                        agents and browser downloads address any path they can reach.
                    </div>
                </div>
            </div>

            <div class="setting-row">
                <input id="follow-symlinks" class="switch" type="checkbox" @bind="_settings.FollowWorkspaceSymlinks" />
                <div class="setting-copy">
                    <label for="follow-symlinks">Follow workspace symlinks</label>
                    <div class="hint">
                        Allow existing symlinks while resolving workspace paths. With validation enabled,
                        their final target must still remain inside the workspace.
                    </div>
                </div>
            </div>

            @if (!_settings.ValidateWorkspacePaths)
            {
                <div class="setting-callout warn">
                    <strong>Warning:</strong>&nbsp;path validation is disabled. Agents can read and write
                    outside their workspaces.
                </div>
            }
            else if (_settings.FollowWorkspaceSymlinks)
            {
                <div class="setting-callout info">
                    Symlinks are enabled. Links to locations outside a workspace are still rejected while
                    path validation remains on.
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="setting-group">
            <div class="setting-group-head">
                <span class="ico">🌐</span>
                <div><h3 style="margin:0">Web tools</h3></div>
            </div>
            <div class="setting-row" style="border-top:none;padding-top:0">
                <input id="enable-web-tools" class="switch" type="checkbox" @bind="_settings.EnableWebTools" />
                <div class="setting-copy">
                    <label for="enable-web-tools">Allow WebFetch and WebSearch</label>
                    <div class="hint">
                        Grants every agent standing permission to fetch URLs and search the web without
                        being asked. Nobody answers permission prompts in a headless session, so leaving
                        this off means those two tools never work at all.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="setting-group">
            <div class="setting-group-head">
                <span class="ico">🎯</span>
                <div><h3 style="margin:0">Goal tracking</h3></div>
            </div>
            <div class="setting-row" style="border-top:none;padding-top:0">
                <input id="enable-goal" class="switch" type="checkbox" @bind="_settings.EnableGoal" />
                <div class="setting-copy">
                    <label for="enable-goal">Track a goal per session</label>
                    <div class="hint">
                        Shows the "Goal" field in the chat sidebar, lets agents read and set it over MCP,
                        and guesses one after a couple of turns if nobody has set it yet — a guess is
                        always shown for confirmation, never adopted automatically.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="setting-group">
            <div class="setting-group-head">
                <span class="ico">💡</span>
                <div><h3 style="margin:0">Prompting tips</h3></div>
            </div>

            <div class="setting-row" style="border-top:none;padding-top:0">
                <input id="enable-prompting-tips" class="switch" type="checkbox" @bind="_settings.EnablePromptingTips" />
                <div class="setting-copy">
                    <label for="enable-prompting-tips">Show prompting tips in chat</label>
                    <div class="hint">
                        Gives practical suggestions for clearer prompts and lower-cost requests. Tips are
                        generated locally and do not use model tokens. Individual agents can override this.
                    </div>
                </div>
            </div>

            <div class="setting-row">
                <input id="use-llm-prompting-tips" class="switch" type="checkbox" @bind="_settings.UseLlmForPromptingTips" />
                <div class="setting-copy">
                    <label for="use-llm-prompting-tips">Use LLM for prompting tips</label>
                    <div class="hint">Asks the model to add a tailored tip to its answer. Warning: this uses extra tokens.</div>
                </div>
            </div>

            <div class="setting-row">
                <input id="enable-guided-quick-chat" class="switch" type="checkbox" @bind="_settings.EnableGuidedQuickChat" />
                <div class="setting-copy">
                    <label for="enable-guided-quick-chat">Guided prompting in quick chat</label>
                    <div class="hint">
                        Locally asks for missing goal, context, constraints, or output details before
                        sending the request to the CLI. No LLM is used for the guidance.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-wide">
        <div class="setting-group">
            <div class="setting-group-head">
                <span class="ico">🔑</span>
                <div><h3 style="margin:0">Shared environment</h3></div>
            </div>
            <p class="small setting-group-desc">
                Variables handed to every AI CLI this install launches — and so to the skills, hooks and
                MCP servers those CLIs start as children. A token set against a single MCP server reaches
                only that one process; set it here and everything the CLI runs can see it. A CLI provider,
                an agent, or the turn itself still overrides a name set here.
            </p>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th style="width:22%">Name</th>
                        <th style="width:30%">Value</th>
                        <th>What it is for</th>
                        <th style="width:1%">On</th>
                        <th style="width:1%">Remote</th>
                        <th style="width:1%"></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var variable in _settings.SharedEnvironment)
                    {
                        <tr @key="variable">
                            <td>
                                <input placeholder="FASTMAIL_API_TOKEN" @bind="variable.Name" @bind:event="oninput" />
                            </td>
                            <td>
                                <div style="display:flex;gap:0.35rem;align-items:center">
                                    <input type="@(_revealed.Contains(variable) ? "text" : "password")"
                                           autocomplete="off"
                                           @bind="variable.Value" @bind:event="oninput" />
                                    <button class="btn btn-ghost btn-sm"
                                            title="@(_revealed.Contains(variable) ? "Hide the value" : "Show the value")"
                                            @onclick="() => ToggleReveal(variable)">
                                        @(_revealed.Contains(variable) ? "🙈" : "👁")
                                    </button>
                                </div>
                            </td>
                            <td>
                                <input placeholder="Fastmail folder skill" @bind="variable.Description" @bind:event="oninput" />
                            </td>
                            <td style="text-align:center">
                                <input class="switch" type="checkbox" @bind="variable.Enabled"
                                       title="Off keeps the value but stops it being passed to anything" />
                            </td>
                            <td style="text-align:center">
                                <input class="switch" type="checkbox" @bind="variable.ShareWithRemote"
                                       title="Send this to remote instances as well. Off by default — a remote applies its own shared environment." />
                            </td>
                            <td>
                                <button class="btn btn-ghost btn-sm btn-danger"
                                        title="Remove this variable"
                                        @onclick="() => Remove(variable)">✕</button>
                            </td>
                        </tr>
                    }
                    @if (_settings.SharedEnvironment.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="small">Nothing shared yet.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.6rem">
                <button class="btn btn-sm" @onclick="Add">Add variable</button>
                <span class="small">
                    Values are stored in this install's data folder as plain text, the same as the
                    environment already set against a CLI provider or an MCP server — keep anything you
                    would not put in that folder out of here. Remote sharing is off until you turn it on
                    per variable. Changes apply to the next turn; opencode picks them up when its server
                    is next restarted.
                </span>
            </div>
        </div>
    </div>

    <div class="card card-wide">
        <div class="setting-group">
            <div class="setting-group-head">
                <span class="ico">🧮</span>
                <div><h3 style="margin:0">Token minimisation defaults</h3></div>
            </div>
            <p class="small setting-group-desc">
                These tactics are selected for new agents and quick chats. Existing agents keep their own
                choices, and each chat can override them.
            </p>
            <TokenMinimisationPicker Value="_settings.DefaultTokenMinimisation"
                                     ValueChanged="SetDefaultTokenMinimisation" />
        </div>
    </div>

</div>

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private GlobalSettings _settings = new();

    /// <summary>Which values are shown in the clear. Per view, never persisted.</summary>
    private readonly HashSet<SharedEnvironmentVariable> _revealed = [];

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsStore.GetAsync(GlobalSettings.WellKnownId) ?? new GlobalSettings();
        PathPolicy.Apply(_settings);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Settings", "Security and application behaviour");
    }

    private void Add()
    {
        var variable = new SharedEnvironmentVariable();
        _settings.SharedEnvironment.Add(variable);

        // A new row has nothing worth hiding yet, and typing into a masked box you cannot read is
        // how a token ends up wrong.
        _revealed.Add(variable);
    }

    private void Remove(SharedEnvironmentVariable variable)
    {
        _settings.SharedEnvironment.Remove(variable);
        _revealed.Remove(variable);
    }

    private void ToggleReveal(SharedEnvironmentVariable variable)
    {
        if (!_revealed.Remove(variable))
            _revealed.Add(variable);
    }

    private async Task SaveAsync()
    {
        // A row somebody added and then left blank is not an error worth a message — just not a
        // variable. Trimmed here so a stray space in a pasted name does not become part of it.
        foreach (var variable in _settings.SharedEnvironment)
            variable.Name = variable.Name.Trim();

        _settings.SharedEnvironment.RemoveAll(v => v.Name.Length == 0 && v.Value.Length == 0);

        await SettingsStore.UpsertAsync(_settings);
        PathPolicy.Apply(_settings);
        Layout.Notify("Settings saved.", "ok");
    }

    private Task SetDefaultTokenMinimisation(TokenTactics? tactics)
    {
        _settings.DefaultTokenMinimisation = tactics ?? TokenTactics.None;
        return Task.CompletedTask;
    }
}
