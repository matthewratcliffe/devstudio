@page "/chat/{SessionId}"
@implements IAsyncDisposable
@inject ISessionManager Sessions
@inject IEntityStore<ChatSession> SessionStore
@inject IGitService Git
@inject IEntityStore<McpServer> McpStore
@inject IWorkspaceFileService WorkspaceFiles
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>@(_session?.Title ?? "Session") · DevStudio</PageTitle>

@if (_session is null)
{
    <div class="empty" style="margin:2rem">That session no longer exists.</div>
}
else
{
    <div class="chat-layout">
        <div class="chat-main">
            <div class="chat-scroll" @ref="_scrollElement">
            <div class="chat-thread">
                @foreach (var message in _session.Messages)
                {
                if (message.Role == MessageRole.Tool)
                {
                    <details class="tool-call">
                        <summary>
                            <span class="caret">▾</span>
                            <span>Tool call</span>
                            @if (ToolNameOf(message) is { Length: > 0 } name)
                            {
                                <span class="tool-name">@name</span>
                            }
                            <span class="mono-dim">@message.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                        </summary>
                        <div class="body">@ToolDetailOf(message)</div>
                    </details>
                }
                else
                {
                    <div class="msg @CssFor(message) @(message.IsStreaming ? "streaming" : "")">
                        @if (message.Role != MessageRole.System)
                        {
                            <div class="who">
                                <span>@Who(message)</span>
                                <span class="mono-dim">@message.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                            </div>
                        }
                        @if (message.Role == MessageRole.Guidance && GuidanceFor(message) is { } guidance)
                        {
                            <div class="guidance-state">
                                @(guidance.Status switch
                                {
                                    GuidanceStatus.Pending => "waiting for the agent to pick this up",
                                    GuidanceStatus.Delivered => "the agent pulled this mid-turn",
                                    _ => "applied at the start of a turn",
                                })
                                @if (guidance.Interrupted)
                                {
                                    <span> · turn interrupted</span>
                                }
                            </div>
                        }
                        <div class="body">
                            @if (message.Role is MessageRole.Agent or MessageRole.Summary)
                            {
                                @((MarkupString)MarkdownLite.ToHtml(message.Content))
                            }
                            else
                            {
                                @message.Content
                            }
                            @if (message.IsStreaming && message.Content.Length == 0)
                            {
                                <span class="typing"><span></span><span></span><span></span></span>
                            }
                        </div>
                    </div>
                }
                }
            </div>
            </div>

            <div class="composer">
                <div class="composer-inner">
                @foreach (var approval in _session.Approvals.Where(a => a.Status == ApprovalStatus.Pending))
                {
                    <div class="approval">
                        <div class="approval-head">
                            <span class="approval-tag">Permission needed</span>
                            <code>@approval.ToolName</code>
                        </div>
                        <div class="approval-detail">@approval.Detail</div>
                        <div class="btn-row">
                            <button class="btn btn-sm btn-primary" @onclick="() => ApproveAsync(approval, retry: true)">
                                Allow &amp; retry
                            </button>
                            <button class="btn btn-sm" @onclick="() => ApproveAsync(approval, retry: false)">Allow</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DenyAsync(approval)">Deny</button>
                            <span class="mono-dim">grants <code>@approval.SuggestedRule</code> for this session</span>
                        </div>
                    </div>
                }
                <div class="composer-row">
                    <textarea @bind="_draft" @bind:event="oninput" @onkeydown="OnKeyDown" @ref="_draftElement"
                              placeholder="@(_session.IsLive ? "The agent is working — your message will be queued." : "Send another turn. Enter to send, Shift+Enter for a new line.")"></textarea>
                    <div style="display:flex;flex-direction:column;gap:0.4rem">
                        <button class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_draft)" @onclick="SendAsync">Send</button>
                        <button class="btn btn-guidance btn-sm" disabled="@string.IsNullOrWhiteSpace(_draft)"
                                title="Steer the agent now instead of queueing a turn"
                                @onclick="SendGuidanceAsync">Guide ⚡</button>
                        @if (_session.IsLive)
                        {
                            <button class="btn btn-danger btn-sm" @onclick="StopAsync">Stop</button>
                        }
                    </div>
                </div>
                @if (_session.Status == SessionStatus.Running)
                {
                    <div class="check" style="margin-top:0.4rem">
                        <input type="checkbox" id="interrupt" @bind="_interrupt" />
                        <label for="interrupt" style="text-transform:none;letter-spacing:0">
                            Interrupt the turn in flight so guidance applies immediately
                        </label>
                    </div>
                }
                @if (_session.Guidance.Any(g => g.Status == GuidanceStatus.Pending))
                {
                    <div class="mono-dim" style="margin-top:0.3rem;color:var(--amber)">
                        @_session.Guidance.Count(g => g.Status == GuidanceStatus.Pending) guidance message(s) waiting to be picked up.
                    </div>
                }
                <div class="mono-dim" style="margin-top:0.4rem">
                    @_session.Status · @_session.Provider · @_session.PermissionMode
                    @if (_session.ProviderSessionId is { Length: > 0 } id)
                    {
                        <span> · resume id @id[..Math.Min(8, id.Length)]</span>
                    }
                </div>
                </div>
            </div>
        </div>

        <aside class="chat-side">
            <div class="section-tag">Session</div>
            <dl class="kv">
                <dt>Agent</dt><dd>@_session.AgentName</dd>
                <dt>Provider</dt><dd>@_session.Provider</dd>
                <dt>Permissions</dt>
                <dd>
                    <select value="@_session.PermissionMode" @onchange="SetPermissionModeAsync">
                        <option value="@PermissionMode.Default">Default — ask for everything</option>
                        <option value="@PermissionMode.Plan">Plan — read only</option>
                        <option value="@PermissionMode.AcceptEdits">Accept edits</option>
                        <option value="@PermissionMode.Unrestricted">No restrictions</option>
                    </select>
                    <span class="hint">Applies from your next message.</span>
                </dd>
                <dt>Account</dt><dd>@(_session.AccountName ?? "default")</dd>
                <dt>Turns</dt><dd>@_session.TurnCount</dd>
                <dt>Trigger</dt><dd>@_session.Trigger</dd>
                <dt>Directory</dt><dd>@_session.WorkingDirectory</dd>
                <dt>Started</dt><dd>@(_session.StartedAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—")</dd>
            </dl>

            @if (_session.LastError is { Length: > 0 })
            {
                <div class="toast err" style="margin-top:0.8rem">@_session.LastError</div>
            }

            @if (!string.IsNullOrWhiteSpace(_session.Summary))
            {
                <div class="divider"></div>
                <div class="section-tag">Rolling summary</div>
                <div class="mono-dim" style="margin-bottom:0.4rem">
                    @_session.SummaryCount summarisation(s) · last @(_session.LastSummarisedAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—")
                </div>
                <div class="small" style="white-space:pre-wrap">@_session.Summary</div>
            }

            @if (_session.Guidance.Count > 0)
            {
                <div class="divider"></div>
                <div class="section-tag">Guidance</div>
                <ul class="list-reset small">
                    @foreach (var guidance in _session.Guidance.OrderByDescending(g => g.CreatedAt))
                    {
                        <li style="margin-bottom:0.5rem">
                            <span class="pill @(guidance.Status == GuidanceStatus.Pending ? "pill-amber" : "pill-lime")">
                                <span class="dot"></span>@guidance.Status
                            </span>
                            <div class="mono-dim">@guidance.Source · @guidance.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                            <div>@guidance.Text</div>
                        </li>
                    }
                </ul>
            }

            <div class="divider"></div>
            <div class="section-tag">Files produced</div>
            <div class="btn-row" style="margin-bottom:0.6rem">
                <button class="btn btn-sm" @onclick="RefreshFilesAsync">Refresh</button>
                @if (_files.Count > 0)
                {
                    <span class="mono-dim">@_files.Count file@(_files.Count == 1 ? "" : "s")</span>
                }
            </div>

            @if (_files.Count == 0)
            {
                <p class="mono-dim">Nothing in the workspace yet.</p>
            }
            else
            {
                <ul class="list-reset small">
                    @foreach (var file in _files.Take(_showAllFiles ? _files.Count : 12))
                    {
                        <li style="margin-bottom:0.6rem">
                            @if (file.IsImage)
                            {
                                <a href="@DownloadUrl(file, inline: true)" target="_blank" rel="noopener">
                                    <img src="@DownloadUrl(file, inline: true)" alt="@file.Name"
                                         style="max-width:100%;border-radius:var(--radius-sm);border:1px solid var(--border);display:block;margin-bottom:0.3rem" />
                                </a>
                            }
                            <a href="@DownloadUrl(file, inline: false)">@file.RelativePath</a>
                            <div class="mono-dim">@Size(file.SizeBytes) · @file.ModifiedAt.ToLocalTime().ToString("dd MMM HH:mm")</div>
                        </li>
                    }
                </ul>

                @if (_files.Count > 12 && !_showAllFiles)
                {
                    <button class="btn btn-sm btn-ghost" @onclick="() => _showAllFiles = true">
                        Show all @_files.Count
                    </button>
                }
            }

            @if (_mcpServers.Count > 0)
            {
                <div class="divider"></div>
                <div class="section-tag">MCP servers</div>
                @foreach (var server in _mcpServers)
                {
                    <label class="check">
                        <input type="checkbox" checked="@(_session.McpServerIds.Contains(server.Id) || server.IsDefault)"
                               disabled="@server.IsDefault"
                               @onchange="e => ToggleMcpAsync(server.Id, e)" />
                        <span>@server.Name @(server.IsDefault ? "(always on)" : "")</span>
                    </label>
                }
                <div class="mono-dim">Changes apply from the next turn.</div>
                @if (_session.PermissionMode == PermissionMode.Plan && (_session.McpServerIds.Count > 0 || _mcpServers.Any(s => s.IsDefault)))
                {
                    <div class="mono-dim" style="color:var(--amber)">
                        This session is in Plan mode, which refuses MCP tool calls. Switch Permissions
                        to Accept edits to actually use these tools.
                    </div>
                }
            }

            @if (_session.AllowedTools.Count > 0)
            {
                <div class="divider"></div>
                <div class="section-tag">Allowed this session</div>
                @foreach (var rule in _session.AllowedTools)
                {
                    <div class="mono-dim" style="display:flex;gap:0.4rem;align-items:center">
                        <code>@rule</code>
                        <button class="btn btn-sm btn-ghost" title="Revoke for the next turn"
                                @onclick="() => RevokeAsync(rule)">×</button>
                    </div>
                }
            }

            <div class="divider"></div>

            <div class="section-tag">Notes</div>
            <textarea @bind="_notes" rows="6" placeholder="Notes for you and for agents reading over MCP."></textarea>
            <div class="btn-row" style="margin-top:0.5rem">
                <button class="btn btn-sm" @onclick="SaveNotesAsync">Save notes</button>
            </div>

            @if (_session.RepositoryId is not null)
            {
                <div class="divider"></div>
                <div class="section-tag">Worktree</div>
                <div class="btn-row" style="margin-bottom:0.6rem">
                    <button class="btn btn-sm" @onclick="RefreshGitAsync">git status</button>
                </div>
                <pre class="mono-dim" style="white-space:pre-wrap;font-size:0.72rem">@_gitStatus</pre>
            }

            <div class="divider"></div>
            <div class="btn-row">
                <button class="btn btn-sm" @onclick="CopyTranscriptAsync">Copy transcript</button>
                <button class="btn btn-sm btn-danger" @onclick="ArchiveAsync">Archive</button>
            </div>
        </aside>
    </div>
}

@code {
    [Parameter] public string SessionId { get; set; } = string.Empty;
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private ChatSession? _session;
    private ElementReference _scrollElement;
    private ElementReference _draftElement;
    private string _draft = string.Empty;
    private bool _interrupt;
    private string _notes = string.Empty;
    private string _gitStatus = string.Empty;
    private IReadOnlyList<McpServer> _mcpServers = [];
    private IReadOnlyList<WorkspaceFile> _files = [];
    private bool _showAllFiles;
    private bool _shouldScroll;
    private bool _forceScroll;

    protected override async Task OnInitializedAsync()
    {
        Sessions.SessionUpdated += OnSessionUpdated;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_session?.Id != SessionId)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _mcpServers = (await McpStore.GetAllAsync()).Where(s => s.Enabled).ToList();
        _session = await Sessions.GetAsync(SessionId);
        _notes = _session?.Notes ?? string.Empty;
        await RefreshFilesAsync();
        _shouldScroll = true;

        if (_session is not null)
            Layout.SetHeader(_session.Title, $"{_session.AgentName} · {_session.Provider}", flush: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Js.InvokeVoidAsync("aiShop.sendOnEnter", _draftElement);

        if (_shouldScroll || firstRender)
        {
            var force = firstRender || _forceScroll;
            _shouldScroll = false;
            _forceScroll = false;
            await Js.InvokeVoidAsync("aiShop.scrollToBottom", _scrollElement, force);
        }
    }

    /// <summary>
    /// Steers the agent instead of queueing a turn. A turn's prompt cannot be rewritten once the CLI
    /// has it, so this publishes the steer to GUIDANCE.md and to MCP for the agent to pull, and folds
    /// it into the next turn — or stops the current turn outright when asked to interrupt.
    /// </summary>
    private async Task SendGuidanceAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft) || _session is null)
            return;

        var text = _draft.Trim();
        _draft = string.Empty;

        try
        {
            await Sessions.SendGuidanceAsync(_session.Id, text, "operator", _interrupt);
            _shouldScroll = true;
            _forceScroll = true;
            Layout.Notify(_interrupt ? "Turn stopped; guidance applied." : "Guidance sent.", "ok");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
    }

    private GuidanceMessage? GuidanceFor(ChatMessage message) =>
        _session?.Guidance.FirstOrDefault(g => g.Text == message.Content);

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft) || _session is null)
            return;

        var message = _draft.Trim();
        _draft = string.Empty;
        await SendMessageAsync(message);
    }

    private async Task SendMessageAsync(string message)
    {
        if (_session is null || string.IsNullOrWhiteSpace(message))
            return;

        try
        {
            await Sessions.SendAsync(_session.Id, message);

            // Your own message always pulls the view down, wherever you had scrolled to.
            _shouldScroll = true;
            _forceScroll = true;
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
    }

    /// <summary>
    /// Enter sends; Shift+Enter starts a new line. The newline itself is suppressed in JS, because
    /// Blazor decides preventDefault when the element renders, not when the key arrives.
    /// </summary>
    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Enter")
            return;

        if (!args.ShiftKey || args.CtrlKey || args.MetaKey)
            await SendAsync();
    }

    private async Task StopAsync()
    {
        if (_session is null)
            return;

        await Sessions.CancelAsync(_session.Id);
        Layout.Notify("Stopping the agent.");
    }

    /// <summary>
    /// Attaches or removes a server for this conversation. The config is rewritten at the start of
    /// the next turn, so a running turn is left alone.
    /// </summary>
    private async Task ToggleMcpAsync(string serverId, ChangeEventArgs args)
    {
        if (_session is null)
            return;

        if (args.Value is true)
        {
            if (!_session.McpServerIds.Contains(serverId))
                _session.McpServerIds.Add(serverId);
        }
        else
        {
            _session.McpServerIds.Remove(serverId);
        }

        await SessionStore.UpsertAsync(_session);
        Layout.Notify("MCP servers updated — they apply from your next message.", "ok");
    }

    /// <summary>
    /// Changes what the CLI is allowed to do from the next turn on. A turn already in flight keeps
    /// the mode it started with, which is the only honest option — its permissions were fixed when
    /// the process launched.
    /// </summary>
    private async Task SetPermissionModeAsync(ChangeEventArgs args)
    {
        if (_session is null || !Enum.TryParse<PermissionMode>(args.Value?.ToString(), out var mode))
            return;

        if (mode == _session.PermissionMode)
            return;

        _session.PermissionMode = mode;
        await SessionStore.UpsertAsync(_session);
        Layout.Notify($"Permissions set to {mode} — applies from your next message.", "ok");
    }

    /// <summary>
    /// Grants the rule for the rest of the session. "Retry" then asks the agent to run the call
    /// again — the CLI has already moved on, so nothing happens by itself.
    /// </summary>
    private async Task ApproveAsync(ToolApproval approval, bool retry)
    {
        if (_session is null)
            return;

        await Sessions.ResolveApprovalAsync(_session.Id, approval.Id, allow: true);
        Layout.Notify($"Allowed {approval.SuggestedRule} for this session.", "ok");

        if (retry)
            await SendMessageAsync($"Permission granted for `{approval.Detail}`. Go ahead and run it now.");
    }

    private async Task RevokeAsync(string rule)
    {
        if (_session is null)
            return;

        _session.AllowedTools.Remove(rule);
        await SessionStore.UpsertAsync(_session);
        Layout.Notify($"Revoked {rule} — it stops applying from the next turn.", "ok");
    }

    private async Task DenyAsync(ToolApproval approval)
    {
        if (_session is null)
            return;

        await Sessions.ResolveApprovalAsync(_session.Id, approval.Id, allow: false);
        Layout.Notify("Left that one blocked.", "ok");
    }

    private async Task SaveNotesAsync()
    {
        if (_session is null)
            return;

        _session.Notes = _notes;
        await SessionStore.UpsertAsync(_session);
        Layout.Notify("Notes saved.", "ok");
    }

    private async Task RefreshFilesAsync()
    {
        if (_session is null)
            return;

        _files = await WorkspaceFiles.ListAsync(_session.Id);
    }

    private string DownloadUrl(WorkspaceFile file, bool inline) =>
        $"/workspace/{SessionId}/{Uri.EscapeDataString(file.RelativePath).Replace("%2F", "/")}{(inline ? "?inline=1" : string.Empty)}";

    private static string Size(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };

    private async Task RefreshGitAsync()
    {
        if (_session is null)
            return;

        _gitStatus = await Git.GetStatusAsync(_session.WorkingDirectory);
    }

    private async Task CopyTranscriptAsync()
    {
        if (_session is null)
            return;

        var text = string.Join("\n\n", _session.Messages.Select(m => $"[{m.Role}] {m.Content}"));
        await Js.InvokeAsync<bool>("aiShop.copy", text);
        Layout.Notify("Transcript copied.", "ok");
    }

    private async Task ArchiveAsync()
    {
        if (_session is null)
            return;

        _session.IsArchived = true;
        await SessionStore.UpsertAsync(_session);
        Nav.NavigateTo("/sessions");
    }

    private void OnSessionUpdated(ChatSession session)
    {
        if (session.Id != SessionId)
            return;

        var wasLive = _session?.IsLive ?? false;
        _session = session;
        _shouldScroll = true;

        // A turn that has just finished is usually the one that wrote the files.
        if (wasLive && !session.IsLive)
        {
            InvokeAsync(async () =>
            {
                await RefreshFilesAsync();
                StateHasChanged();
            });

            return;
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>A tool event is stored as "name detail", so the name is the first token.</summary>
    private static string ToolNameOf(ChatMessage message)
    {
        var space = message.Content.IndexOf(' ');
        return (space > 0 ? message.Content[..space] : message.Content).Trim();
    }

    private static string ToolDetailOf(ChatMessage message)
    {
        var space = message.Content.IndexOf(' ');
        var detail = space > 0 ? message.Content[(space + 1)..].Trim() : string.Empty;

        // A tool with nothing but a name still needs something behind the caret.
        return detail.Length > 0 ? detail : message.Content.Trim();
    }

    private static string CssFor(ChatMessage message) => message.Role switch
    {
        MessageRole.User => "msg-user",
        MessageRole.Agent => "msg-agent",
        MessageRole.Tool => "msg-tool",
        MessageRole.Guidance => "msg-guidance",
        MessageRole.Summary => "msg-summary",
        MessageRole.Error => "msg-error",
        _ => "msg-system",
    };

    private string Who(ChatMessage message) => message.Role switch
    {
        MessageRole.User => "You",
        MessageRole.Agent => _session?.AgentName ?? "Agent",
        MessageRole.Tool => "Tool",
        MessageRole.Guidance => "Guidance",
        MessageRole.Summary => "Summary",
        MessageRole.Error => "Error",
        _ => "System",
    };

    public ValueTask DisposeAsync()
    {
        Sessions.SessionUpdated -= OnSessionUpdated;
        return ValueTask.CompletedTask;
    }
}
