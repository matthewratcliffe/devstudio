@page "/repositories"
@inject IEntityStore<GitRepository> RepositoryStore
@inject IGitService Git
@inject ISourceControlRegistry Forges
@inject Microsoft.Extensions.Options.IOptions<OrchestratorOptions> Options

<PageTitle>Repositories · devStudio</PageTitle>

<div class="card" style="margin-bottom:1.2rem">
    <div class="section-tag">Clone</div>
    <div class="form-grid">
        <div class="field">
            <label>Remote URL</label>
            <input type="text" @bind="_remoteUrl" placeholder="https://github.com/you/repo.git or owner/repo" />
        </div>
        <div class="field">
            <label>Folder name (optional)</label>
            <input type="text" @bind="_name" placeholder="derived from the URL" />
        </div>
    </div>
    <div class="field" style="max-width:320px">
        <label>Forge</label>
        <select @bind="_forge">
            @foreach (var cli in Forges.All)
            {
                <option value="@cli.Provider">@cli.DisplayName</option>
            }
        </select>
    </div>

    <div class="btn-row">
        <button class="btn btn-primary" disabled="@(_cloning || string.IsNullOrWhiteSpace(_remoteUrl))" @onclick="CloneAsync">
            @(_cloning ? "Cloning…" : "Clone into volume")
        </button>
        <button class="btn btn-ghost" disabled="@_loadingRemote" @onclick="LoadRemoteReposAsync">
            List available @Forges.Get(_forge).DisplayName repos
        </button>
        <span class="mono-dim">Private repos clone through that CLI's login.</span>
    </div>

    @if (_remoteRepos.Count > 0)
    {
        <div class="divider"></div>
        <div class="table-wrap" style="max-height:280px;overflow-y:auto">
            <table class="table">
                <tbody>
                @foreach (var repo in _remoteRepos)
                {
                    <tr>
                        <td>@repo.FullName @(repo.IsPrivate ? "🔒" : "")</td>
                        <td class="mono-dim">@repo.Description</td>
                        <td><button class="btn btn-sm" @onclick="() => PickAsync(repo)">Use</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card" style="margin-bottom:1.2rem">
    <div class="section-tag">Attach local folder</div>

    @if (Git.LocalRepositoryRoots.Count == 0)
    {
        <p class="mono-dim">
            Nothing is mounted. To work on the same checkout your IDE has open, bind mount it into the
            container and list the mount point here:
        </p>
        <pre class="mono-dim" style="white-space:pre-wrap;font-size:0.75rem">volumes:
  - D:/repos:/host/repos
environment:
  Orchestrator__LocalRepositoryRoots__0: "/host/repos"</pre>
    }
    else
    {
        <div class="btn-row" style="margin-bottom:0.6rem">
            <button class="btn btn-sm btn-ghost" disabled="@(_browsing || _browse?.ParentPath is null && _browse?.Path is null)"
                    @onclick="() => BrowseAsync(_browse?.Path is null ? null : _browse.ParentPath)">
                ↑ Up
            </button>
            <span class="mono-dim">@(_browse?.Path ?? "mounted roots")</span>
        </div>

        <div class="field" style="max-width:320px">
            <label>Name (optional)</label>
            <input type="text" @bind="_localName" placeholder="the folder name" />
        </div>

        @if (_browse is { Entries.Count: 0 })
        {
            <div class="mono-dim">Nothing here. The mount may be empty, or its folders are all hidden.</div>
        }
        else if (_browse is not null)
        {
            <div class="table-wrap" style="max-height:320px;overflow-y:auto">
                <table class="table">
                    <tbody>
                    @foreach (var entry in _browse.Entries)
                    {
                        <tr>
                            <td>@entry.Name</td>
                            <td class="mono-dim">
                                @if (entry.IsRegistered)
                                {
                                    <span class="pill">already attached</span>
                                }
                                else if (entry.IsGitRepository)
                                {
                                    <span class="pill">git repo</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-ghost" disabled="@_browsing" @onclick="() => BrowseAsync(entry.Path)">Open</button>
                                @if (entry.IsGitRepository && !entry.IsRegistered)
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@_attaching" @onclick="() => AttachAsync(entry.Path)">Attach</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <div class="mono-dim" style="margin-top:0.7rem">
            Attached repos are never cloned or deleted. Worktrees for them are cut into
            <code>@Options.Value.LocalWorktreesFolderName</code> beside the checkout, so the IDE sees them too.
        </div>
    }
</div>

@if (_repositories.Count == 0)
{
    <div class="empty">
        <div class="big">⑂</div>
        No repositories yet. Clone one so agents can work in isolated worktrees.
    </div>
}

@foreach (var repository in _repositories)
{
    <div class="card" style="margin-bottom:1rem">
        <div class="card-head">
            <h3>@repository.Name</h3>
            <div class="spacer"></div>
            @if (repository.IsLocal)
            {
                <span class="pill">local mount</span>
            }
            <span class="pill">@repository.SourceControl</span>
            <span class="pill">@repository.DefaultBranch</span>
            <span class="pill">@repository.Worktrees.Count worktrees</span>
        </div>
        <div class="mono-dim">@(string.IsNullOrWhiteSpace(repository.RemoteUrl) ? "no origin remote" : repository.RemoteUrl)</div>
        <div class="mono-dim" style="margin-bottom:0.7rem">@repository.LocalPath</div>

        @if (repository.LastError is { Length: > 0 })
        {
            <div class="toast err" style="margin-bottom:0.7rem">@repository.LastError</div>
        }

        <div class="btn-row" style="margin-bottom:0.8rem">
            @if (!string.IsNullOrWhiteSpace(repository.RemoteUrl))
            {
                <button class="btn btn-sm" @onclick="() => FetchAsync(repository)">Fetch</button>
            }
            <button class="btn btn-sm btn-ghost" @onclick="() => ToggleBranchesAsync(repository)">Branches</button>
            <button class="btn btn-sm btn-ghost" @onclick="() => NewWorktreeAsync(repository)">New worktree</button>
            <button class="btn btn-sm btn-danger" @onclick="() => ForgetAsync(repository)">@(repository.IsLocal ? "Detach" : "Forget")</button>
        </div>

        @if (_branchesFor == repository.Id)
        {
            <div class="btn-row" style="margin-bottom:0.8rem">
                @foreach (var branch in _branches)
                {
                    <span class="pill">@branch</span>
                }
            </div>
        }

        @if (repository.Worktrees.Count > 0)
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr><th>Branch</th><th>Path</th><th>Created</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var worktree in repository.Worktrees)
                    {
                        <tr>
                            <td>@worktree.Branch</td>
                            <td class="mono-dim">@worktree.Path</td>
                            <td class="mono-dim"><LocalTime Value="@worktree.CreatedAt" Format="daytime" /></td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="() => RemoveWorktreeAsync(repository, worktree)">Remove</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<GitRepository> _repositories = [];
    private IReadOnlyList<RemoteRepoSummary> _remoteRepos = [];
    private SourceControlProvider _forge = SourceControlProvider.GitHub;
    private IReadOnlyList<string> _branches = [];
    private string? _branchesFor;

    private LocalBrowseResult? _browse;
    private bool _browsing;
    private bool _attaching;
    private string _localName = string.Empty;

    private string _remoteUrl = string.Empty;
    private string _name = string.Empty;
    private bool _cloning;
    private bool _loadingRemote;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();

        if (Git.LocalRepositoryRoots.Count > 0)
            await BrowseAsync(null);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Repositories", "Clones and worktrees on the volume");
    }

    private async Task ReloadAsync() => _repositories = await RepositoryStore.GetAllAsync();

    private async Task CloneAsync()
    {
        _cloning = true;
        try
        {
            var repository = await Git.CloneAsync(_remoteUrl.Trim(), string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(), _forge);
            _remoteUrl = string.Empty;
            _name = string.Empty;
            await ReloadAsync();
            Layout.Notify($"Cloned {repository.Name}.", "ok");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
        finally
        {
            _cloning = false;
        }
    }

    private async Task BrowseAsync(string? path)
    {
        _browsing = true;
        try
        {
            _browse = await Git.BrowseLocalAsync(path);
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
        finally
        {
            _browsing = false;
        }
    }

    private async Task AttachAsync(string path)
    {
        _attaching = true;
        try
        {
            var repository = await Git.AttachLocalAsync(path, string.IsNullOrWhiteSpace(_localName) ? null : _localName.Trim());
            _localName = string.Empty;
            await ReloadAsync();
            // Re-listing marks the folder as attached rather than leaving an Attach button that no-ops.
            await BrowseAsync(_browse?.Path);
            Layout.Notify($"Attached {repository.Name}.", "ok");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
        finally
        {
            _attaching = false;
        }
    }

    private async Task LoadRemoteReposAsync()
    {
        _loadingRemote = true;
        try
        {
            var cli = Forges.Get(_forge);
            _remoteRepos = await cli.ListRepositoriesAsync(100);

            if (_remoteRepos.Count == 0)
                Layout.Notify($"No repositories came back — is {cli.Executable} logged in?", "err");
        }
        finally
        {
            _loadingRemote = false;
        }
    }

    private Task PickAsync(RemoteRepoSummary repo)
    {
        _remoteUrl = string.IsNullOrWhiteSpace(repo.CloneUrl) ? repo.FullName : repo.CloneUrl;
        return Task.CompletedTask;
    }

    private async Task FetchAsync(GitRepository repository)
    {
        var result = await Git.FetchAsync(repository);
        Layout.Notify(result.Succeeded ? "Fetched." : result.Output, result.Succeeded ? "ok" : "err");
        await ReloadAsync();
    }

    private async Task ToggleBranchesAsync(GitRepository repository)
    {
        if (_branchesFor == repository.Id)
        {
            _branchesFor = null;
            return;
        }

        _branches = await Git.ListBranchesAsync(repository);
        _branchesFor = repository.Id;
    }

    private async Task NewWorktreeAsync(GitRepository repository)
    {
        try
        {
            var branch = $"work/{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss}";
            await Git.CreateWorktreeAsync(repository, branch, repository.DefaultBranch, ephemeral: false);
            await ReloadAsync();
            Layout.Notify($"Created {branch}.", "ok");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
    }

    private async Task RemoveWorktreeAsync(GitRepository repository, Worktree worktree)
    {
        await Git.RemoveWorktreeAsync(repository, worktree);
        await ReloadAsync();
    }

    private async Task ForgetAsync(GitRepository repository)
    {
        // Only the registration goes; the clone stays on the volume so nothing is lost by accident.
        var wasLocal = repository.IsLocal;
        await RepositoryStore.DeleteAsync(repository.Id);
        await ReloadAsync();

        if (wasLocal && Git.LocalRepositoryRoots.Count > 0)
            await BrowseAsync(_browse?.Path);

        Layout.Notify(wasLocal ? "Detached. The folder on the mount is untouched." : "Removed from the list. The clone is still on disk.", "ok");
    }
}
