@page "/schedules"
@inject IEntityStore<Schedule> ScheduleStore
@inject IEntityStore<Agent> AgentStore
@inject IEntityStore<Workflow> WorkflowStore
@inject IEntityStore<Project> ProjectStore
@inject SchedulerHostedService Scheduler

<PageTitle>Schedules · devStudio</PageTitle>

<div class="btn-row" style="margin-bottom:1.2rem">
    <button class="btn btn-primary" @onclick="() => Edit(new Schedule())">New schedule</button>
    <span class="mono-dim">Cron, a plain timer, or manual-only so you can keep a saved run configuration.</span>
</div>

<div class="table-wrap">
    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Target</th>
            <th>Project</th>
            <th>Trigger</th>
            <th>Next run</th>
            <th>Last run</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var schedule in _schedules)
        {
            <tr>
                <td>
                    @schedule.Name
                    @if (schedule.TeamSourcePath is { Length: > 0 } source)
                    {
                        <span class="pill" style="margin-left:0.4rem" title="From the team settings repository: @source">team</span>
                    }
                    @if (!schedule.Enabled)
                    {
                        <span class="pill pill-red" style="margin-left:0.4rem">paused</span>
                    }
                </td>
                <td class="mono-dim">@TargetName(schedule)</td>
                <td class="mono-dim">@ProjectName(schedule.ProjectId)</td>
                <td class="mono-dim">@Trigger(schedule)</td>
                <td class="mono-dim">@if (schedule.NextRunAt is { } __t1) { <LocalTime Value="@__t1" Format="weekdaydate" /> } else { <text>—</text> }</td>
                <td class="mono-dim">
                    @if (schedule.LastRunAt is { } __t2) { <LocalTime Value="@__t2" Format="daytime" /> } else { <text>never</text> }
                    @if (schedule.LastError is { Length: > 0 })
                    {
                        <span class="pill pill-red" style="margin-left:0.4rem">error</span>
                    }
                </td>
                <td>
                    <div class="btn-row">
                        <button class="btn btn-sm btn-primary" @onclick="() => RunNowAsync(schedule)">Run now</button>
                        <button class="btn btn-sm" @onclick="() => Edit(schedule)">Edit</button>
                        <button class="btn btn-sm btn-ghost" @onclick="() => ToggleAsync(schedule)">
                            @(schedule.Enabled ? "Pause" : "Resume")
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(schedule)">Delete</button>
                    </div>
                </td>
            </tr>
        }
        @if (_schedules.Count == 0)
        {
            <tr><td colspan="7" class="mono-dim">No schedules yet.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="() => _editing = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>@(_isNew ? "New schedule" : _editing.Name)</h2>

            <div class="field">
                <label>Name</label>
                <input type="text" @bind="_editing.Name" />
            </div>

            <div class="form-grid">
                <div class="field">
                    <label>Runs</label>
                    <select @bind="_editing.Target">
                        <option value="@ScheduleTarget.Agent">An agent</option>
                        <option value="@ScheduleTarget.Workflow">A workflow</option>
                    </select>
                </div>
                <div class="field">
                    <label>@(_editing.Target == ScheduleTarget.Agent ? "Agent" : "Workflow")</label>
                    <select @bind="_editing.TargetId">
                        <option value="">Pick one</option>
                        @if (_editing.Target == ScheduleTarget.Agent)
                        {
                            @foreach (var agent in _agents)
                            {
                                <option value="@agent.Id">@agent.Name — @agent.Provider</option>
                            }
                        }
                        else
                        {
                            @foreach (var workflow in _workflows)
                            {
                                <option value="@workflow.Id">@workflow.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="field">
                <label>Project folder</label>
                <select @bind="_editing.ProjectId">
                    <option value="">None</option>
                    @foreach (var project in _projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
                <span class="hint">The run happens in this project's folder, with its instructions and files.</span>
            </div>

            @if (_editing.Target == ScheduleTarget.Agent)
            {
                <div class="field">
                    <label>Prompt</label>
                    <textarea rows="4" @bind="_editing.Prompt"
                              placeholder="What the agent should do each time it fires."></textarea>
                    <span class="hint">Leave this empty to send the agent's own default first prompt.</span>
                </div>
            }
            else
            {
                <div class="field">
                    <label>Workflow inputs (KEY=value per line)</label>
                    <textarea rows="4" value="@InputsText" @onchange="e => SetInputs(e.Value?.ToString())"></textarea>
                </div>
            }

            <div class="divider"></div>

            <div class="form-grid">
                <div class="field">
                    <label>Trigger</label>
                    <select @bind="_editing.Kind">
                        <option value="@ScheduleKind.Cron">Cron expression</option>
                        <option value="@ScheduleKind.Interval">Every N minutes</option>
                        <option value="@ScheduleKind.Manual">Manual only</option>
                    </select>
                </div>

                @if (_editing.Kind == ScheduleKind.Cron)
                {
                    <div class="field">
                        <label>Cron</label>
                        <input type="text" @bind="_editing.CronExpression" @bind:event="oninput" placeholder="0 9 * * 1-5" />
                        <span class="hint">
                            @CronHint
                            @if (NextOccurrence is { } next)
                            {
                                <LocalTime Value="@next" Format="weekdaydate" />
                            }
                        </span>
                    </div>
                }
                else if (_editing.Kind == ScheduleKind.Interval)
                {
                    <div class="field">
                        <label>Minutes</label>
                        <input type="number" @bind="_editing.IntervalMinutes" />
                    </div>
                }
            </div>

            <div class="field">
                <label>Time zone</label>
                <input type="text" @bind="_editing.TimeZoneId" placeholder="UTC, Australia/Melbourne" />
            </div>

            <div class="check">
                <input type="checkbox" id="skip-running" @bind="_editing.SkipIfRunning" />
                <label for="skip-running" style="text-transform:none;letter-spacing:0">Skip a slot if the previous run is still going</label>
            </div>
            <div class="check">
                <input type="checkbox" id="sched-enabled" @bind="_editing.Enabled" />
                <label for="sched-enabled" style="text-transform:none;letter-spacing:0">Enabled</label>
            </div>

            <div class="btn-row">
                <button class="btn btn-primary" @onclick="SaveAsync">Save schedule</button>
                <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<Schedule> _schedules = [];
    private IReadOnlyList<Agent> _agents = [];
    private IReadOnlyList<Workflow> _workflows = [];
    private IReadOnlyList<Project> _projects = [];
    private Schedule? _editing;
    private bool _isNew;

    private string InputsText => string.Join('\n', _editing!.Inputs.Select(i => $"{i.Key}={i.Value}"));

    private string CronHint
    {
        get
        {
            if (_editing is null)
                return string.Empty;

            if (!CronExpression.TryParse(_editing.CronExpression, out var cron, out var error) || cron is null)
                return error;

            return NextOccurrence is null ? "Valid, but never fires." : "Next:";
        }
    }

    /// <summary>
    /// When the expression next fires, as an instant. The schedule's own timezone decides when that
    /// is; the browser decides how it reads.
    /// </summary>
    private DateTimeOffset? NextOccurrence
    {
        get
        {
            if (_editing is null || !CronExpression.TryParse(_editing.CronExpression, out var cron, out _) || cron is null)
                return null;

            return cron.GetNextOccurrence(DateTimeOffset.UtcNow, ResolveZone(_editing.TimeZoneId));
        }
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Schedules", "Cron and timer triggers for agents and workflows");
    }

    private async Task ReloadAsync()
    {
        _schedules = await ScheduleStore.GetAllAsync();
        _agents = await AgentStore.GetAllAsync();
        _workflows = await WorkflowStore.GetAllAsync();
        _projects = await ProjectStore.GetAllAsync();
    }

    private void Edit(Schedule schedule)
    {
        _isNew = _schedules.All(s => s.Id != schedule.Id);
        _editing = _isNew ? schedule : Clone(schedule);
    }

    private async Task SaveAsync()
    {
        if (_editing is null)
            return;

        if (string.IsNullOrWhiteSpace(_editing.TargetId))
        {
            Layout.Notify("Pick something for the schedule to run.", "err");
            return;
        }

        if (_editing.Kind == ScheduleKind.Cron &&
            !CronExpression.TryParse(_editing.CronExpression, out _, out var error))
        {
            Layout.Notify(error, "err");
            return;
        }

        _editing.ProjectId = string.IsNullOrWhiteSpace(_editing.ProjectId) ? null : _editing.ProjectId;
        // Recompute so the list shows the new timing straight away.
        _editing.NextRunAt = SchedulerHostedService.ComputeNext(_editing, DateTimeOffset.UtcNow);

        await ScheduleStore.UpsertAsync(_editing);
        _editing = null;
        await ReloadAsync();
        Layout.Notify("Schedule saved.", "ok");
    }

    private async Task RunNowAsync(Schedule schedule)
    {
        Layout.Notify($"Triggering {schedule.Name}…");
        await Scheduler.TriggerAsync(schedule);
        await ReloadAsync();
    }

    private async Task ToggleAsync(Schedule schedule)
    {
        schedule.Enabled = !schedule.Enabled;
        schedule.NextRunAt = schedule.Enabled
            ? SchedulerHostedService.ComputeNext(schedule, DateTimeOffset.UtcNow)
            : null;

        await ScheduleStore.UpsertAsync(schedule);
        await ReloadAsync();
    }

    private async Task DeleteAsync(Schedule schedule)
    {
        await ScheduleStore.DeleteAsync(schedule.Id);
        await ReloadAsync();
    }

    private void SetInputs(string? value)
    {
        var inputs = new Dictionary<string, string>();
        foreach (var line in (value ?? string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var separator = line.IndexOf('=');
            if (separator > 0)
                inputs[line[..separator].Trim()] = line[(separator + 1)..].Trim();
        }

        _editing!.Inputs = inputs;
    }

    private string TargetName(Schedule schedule) => schedule.Target == ScheduleTarget.Agent
        ? _agents.FirstOrDefault(a => a.Id == schedule.TargetId)?.Name ?? "(missing agent)"
        : _workflows.FirstOrDefault(w => w.Id == schedule.TargetId)?.Name ?? "(missing workflow)";

    private string ProjectName(string? projectId) =>
        projectId is null ? "—" : _projects.FirstOrDefault(p => p.Id == projectId)?.Name ?? "—";

    private static string Trigger(Schedule schedule) => schedule.Kind switch
    {
        ScheduleKind.Cron => schedule.CronExpression,
        ScheduleKind.Interval => $"every {schedule.IntervalMinutes}m",
        _ => "manual",
    };

    private static TimeZoneInfo ResolveZone(string id)
    {
        try
        {
            return string.IsNullOrWhiteSpace(id) ? TimeZoneInfo.Utc : TimeZoneInfo.FindSystemTimeZoneById(id);
        }
        catch (Exception)
        {
            return TimeZoneInfo.Utc;
        }
    }

    private static Schedule Clone(Schedule schedule) => new()
    {
        Id = schedule.Id,
        CreatedAt = schedule.CreatedAt,
        Name = schedule.Name,
        Description = schedule.Description,
        Kind = schedule.Kind,
        CronExpression = schedule.CronExpression,
        IntervalMinutes = schedule.IntervalMinutes,
        TimeZoneId = schedule.TimeZoneId,
        Target = schedule.Target,
        TargetId = schedule.TargetId,
        ProjectId = schedule.ProjectId,
        Prompt = schedule.Prompt,
        Inputs = new Dictionary<string, string>(schedule.Inputs),
        Enabled = schedule.Enabled,
        SkipIfRunning = schedule.SkipIfRunning,
        LastRunAt = schedule.LastRunAt,
        NextRunAt = schedule.NextRunAt,
        LastRunId = schedule.LastRunId,
        LastError = schedule.LastError,
        RunCount = schedule.RunCount,
    };
}
