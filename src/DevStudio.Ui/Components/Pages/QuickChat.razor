@page "/quick-chat"
@inject IProviderCliRegistry Clis
@inject IQuickChatService QuickChats
@inject ISessionManager Sessions
@inject IEntityStore<McpServer> McpStore
@inject NavigationManager Nav

<PageTitle>Quick chat · DevStudio</PageTitle>

<div class="card" style="max-width:900px;margin-bottom:1.2rem">
    <div class="section-tag">Just ask</div>
    <p class="small">
        No project, no agent, no worktree — pick a CLI and talk. It runs in a scratch directory, and
        read-only unless you say otherwise, so nothing gets edited by surprise. Everything else still
        applies: the session is saved, you can steer it, and it appears in Sessions like any other.
    </p>

    <div class="field">
        <label>Talk to</label>
        <select value="@_selected" @onchange="e => _selected = e.Value?.ToString() ?? string.Empty">
            @foreach (var cli in _clis)
            {
                <option value="@Key(cli)">@cli.DisplayName</option>
            }
        </select>
    </div>

    <div class="field">
        <label>Permissions</label>
        <select @bind="_permissionMode">
            <option value="@PermissionMode.Plan">Plan — read only</option>
            <option value="@PermissionMode.Default">Default — ask for everything</option>
            <option value="@PermissionMode.AcceptEdits">Accept edits</option>
            <option value="@PermissionMode.Unrestricted">No restrictions</option>
        </select>
        <span class="hint">You can change this later from the chat itself.</span>
    </div>

    @if (_mcpServers.Count > 0)
    {
        <div class="field">
            <label>MCP servers</label>
            <div class="btn-row">
                @foreach (var server in _mcpServers)
                {
                    <label class="check" style="margin:0">
                        <input type="checkbox" checked="@(_selectedMcp.Contains(server.Id) || server.IsDefault)"
                               disabled="@server.IsDefault"
                               @onchange="e => ToggleMcp(server.Id, e)" />
                        <span>@server.Name @(server.IsDefault ? "(always on)" : "")</span>
                    </label>
                }
            </div>
            <span class="hint">Wired into this chat only. Add more later from the chat itself.</span>
            @if (_permissionMode == PermissionMode.Plan && (_selectedMcp.Count > 0 || _mcpServers.Any(s => s.IsDefault)))
            {
                <span class="hint" style="color:var(--amber)">
                    Plan mode refuses every MCP tool call. Choose Accept edits to actually use these.
                </span>
            }
        </div>
    }

    <div class="field">
        <label>Message</label>
        <textarea @bind="_prompt" @bind:event="oninput" rows="6" @onkeydown="OnKeyDown"
                  placeholder="Ask anything. Ctrl+Enter to send."></textarea>
    </div>

    <div class="btn-row">
        <button class="btn btn-primary" disabled="@(_starting || string.IsNullOrWhiteSpace(_prompt))" @onclick="StartAsync">
            @(_starting ? "Starting…" : "Start chat")
        </button>
        <span class="mono-dim">@ModeSummary · scratch workspace</span>
    </div>
</div>

@if (_recent.Count > 0)
{
    <div class="section-tag">Recent quick chats</div>
    <div class="table-wrap" style="max-width:900px">
        <table class="table">
            <thead>
            <tr><th>Chat</th><th>CLI</th><th>Status</th><th>When</th></tr>
            </thead>
            <tbody>
            @foreach (var session in _recent)
            {
                <tr style="cursor:pointer" @onclick="() => Open(session)">
                    <td>@session.Title</td>
                    <td class="mono-dim">@(session.CliProviderName ?? session.Provider.ToString())</td>
                    <td><StatusPill Session="session.Status" /></td>
                    <td class="mono-dim">@session.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<IProviderCli> _clis = [];
    private List<ChatSession> _recent = [];
    private string _selected = string.Empty;
    private string _prompt = string.Empty;
    private bool _starting;
    private IReadOnlyList<McpServer> _mcpServers = [];
    private readonly HashSet<string> _selectedMcp = [];

    // Read-only unless asked otherwise: a chat window should not edit anything by surprise.
    private PermissionMode _permissionMode = PermissionMode.Plan;

    private string ModeSummary => _permissionMode switch
    {
        PermissionMode.Plan => "Read-only",
        PermissionMode.Default => "Asks first",
        PermissionMode.AcceptEdits => "Edits allowed",
        _ => "No restrictions",
    };

    protected override async Task OnInitializedAsync()
    {
        _clis = await Clis.GetAllAsync();
        _mcpServers = (await McpStore.GetAllAsync()).Where(s => s.Enabled).ToList();
        _selected = _clis.Count > 0 ? Key(_clis[0]) : string.Empty;

        var all = await Sessions.GetAllAsync();
        _recent = all.Where(s => s.Title.StartsWith("Quick chat", StringComparison.Ordinal) || s.AgentName.StartsWith("Quick chat", StringComparison.Ordinal))
            .Where(s => !s.IsArchived)
            .Take(8)
            .ToList();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Quick chat", "A conversation with no setup");
    }

    /// <summary>Built-ins are keyed by provider; custom CLIs by their definition id.</summary>
    private static string Key(IProviderCli cli) =>
        cli.DefinitionId is { Length: > 0 } id ? $"custom:{id}" : cli.Provider.ToString();

    private async Task StartAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt) || string.IsNullOrWhiteSpace(_selected))
            return;

        _starting = true;
        try
        {
            var (provider, cliProviderId) = _selected.StartsWith("custom:", StringComparison.Ordinal)
                ? (AiProvider.Custom, _selected["custom:".Length..])
                : (Enum.Parse<AiProvider>(_selected), null);

            var session = await QuickChats.StartAsync(
                provider, cliProviderId, _prompt, _selectedMcp.ToList(), _permissionMode);
            Nav.NavigateTo($"/chat/{session.Id}");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
            _starting = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
            await StartAsync();
    }

    private void ToggleMcp(string id, ChangeEventArgs args)
    {
        if (args.Value is true)
            _selectedMcp.Add(id);
        else
            _selectedMcp.Remove(id);
    }

    private void Open(ChatSession session) => Nav.NavigateTo($"/chat/{session.Id}");
}
