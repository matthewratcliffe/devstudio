@page "/skills"
@inject IEntityStore<Skill> SkillStore
@inject IEntityStore<Agent> AgentStore

<PageTitle>Skills · devStudio</PageTitle>

<div class="btn-row" style="margin-bottom:1.2rem">
    <button class="btn btn-primary" @onclick="() => Edit(new Skill())">New skill</button>
    <span class="mono-dim">
        Written to <code>.claude/skills/&lt;slug&gt;/SKILL.md</code> in the workspace before a session starts.
    </span>
</div>

<div class="grid grid-auto">
    @foreach (var skill in _skills)
    {
        <div class="card">
            <div class="card-head">
                <h3>@skill.Name</h3>
                <div class="spacer"></div>
                @if (!skill.Enabled)
                {
                    <span class="pill pill-red">off</span>
                }
            </div>
            <p class="small">@skill.Description</p>
            <div class="btn-row" style="margin-bottom:0.7rem">
                <span class="pill">@Slug(skill)</span>
                @foreach (var tag in skill.Tags)
                {
                    <span class="pill">@tag</span>
                }
                <span class="pill">used by @UsageCount(skill.Id)</span>
            </div>
            <div class="btn-row">
                <button class="btn btn-sm" @onclick="() => Edit(skill)">Edit</button>
                <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(skill)">Delete</button>
            </div>
        </div>
    }
</div>

@if (_skills.Count == 0)
{
    <div class="empty">
        <div class="big">◆</div>
        No skills yet. A skill is a reusable instruction file agents can load on demand.
    </div>
}

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="() => _editing = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>@(_isNew ? "New skill" : _editing.Name)</h2>

            <div class="form-grid">
                <div class="field">
                    <label>Name</label>
                    <input type="text" @bind="_editing.Name" />
                </div>
                <div class="field">
                    <label>Slug</label>
                    <input type="text" @bind="_editing.Slug" placeholder="derived from the name" />
                </div>
            </div>

            <div class="field">
                <label>When to use it</label>
                <input type="text" @bind="_editing.Description"
                       placeholder="One line — this is what the model reads to decide whether to load it." />
            </div>

            <div class="field">
                <label>Instructions (markdown)</label>
                <textarea @bind="_editing.Content" rows="14"></textarea>
            </div>

            <div class="field">
                <label>Tags (comma separated)</label>
                <input type="text" value="@string.Join(", ", _editing.Tags)"
                       @onchange="e => SetTags(e.Value?.ToString())" />
            </div>

            <div class="check">
                <input type="checkbox" id="skill-enabled" @bind="_editing.Enabled" />
                <label for="skill-enabled" style="text-transform:none;letter-spacing:0">Enabled</label>
            </div>

            <div class="btn-row">
                <button class="btn btn-primary" @onclick="SaveAsync">Save skill</button>
                <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<Skill> _skills = [];
    private IReadOnlyList<Agent> _agents = [];
    private Skill? _editing;
    private bool _isNew;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Skills", "Reusable instructions agents can load");
    }

    private async Task ReloadAsync()
    {
        _skills = await SkillStore.GetAllAsync();
        _agents = await AgentStore.GetAllAsync();
    }

    private void Edit(Skill skill)
    {
        _isNew = _skills.All(s => s.Id != skill.Id);
        _editing = _isNew ? skill : Clone(skill);
    }

    private async Task SaveAsync()
    {
        if (_editing is null)
            return;

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            Layout.Notify("A skill needs a name.", "err");
            return;
        }

        if (string.IsNullOrWhiteSpace(_editing.Slug))
            _editing.Slug = TemplateRenderer.Slugify(_editing.Name);

        await SkillStore.UpsertAsync(_editing);
        _editing = null;
        await ReloadAsync();
        Layout.Notify("Skill saved.", "ok");
    }

    private async Task DeleteAsync(Skill skill)
    {
        await SkillStore.DeleteAsync(skill.Id);
        await ReloadAsync();
    }

    private void SetTags(string? value) =>
        _editing!.Tags = (value ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

    private int UsageCount(string skillId) => _agents.Count(a => a.SkillIds.Contains(skillId));

    private static string Slug(Skill skill) =>
        string.IsNullOrWhiteSpace(skill.Slug) ? TemplateRenderer.Slugify(skill.Name) : skill.Slug;

    private static Skill Clone(Skill skill) => new()
    {
        Id = skill.Id,
        CreatedAt = skill.CreatedAt,
        Name = skill.Name,
        Slug = skill.Slug,
        Description = skill.Description,
        Content = skill.Content,
        Tags = [.. skill.Tags],
        Enabled = skill.Enabled,
    };
}
