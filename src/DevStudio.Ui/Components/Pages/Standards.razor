@page "/standards"
@inject IEntityStore<GlobalSettings> SettingsStore
@inject IEntityStore<Project> ProjectStore
@inject IFileLibraryService Files

<PageTitle>Standards · DevStudio</PageTitle>

<div class="card" style="margin-bottom:1.2rem">
    <div class="section-tag">What this is</div>
    <p class="small">
        The house rules. Everything here goes into the system prompt of every session, underneath the
        project's own instructions, and every uploaded file is staged into
        <code>./global-files</code> in each agent's working directory. Put your setup guide, coding
        standards and architecture notes here once instead of repeating them in every project.
    </p>
    @if (_optedOut.Count > 0)
    {
        <div class="mono-dim">
            Not applied in: @string.Join(", ", _optedOut.Select(p => p.Name))
        </div>
    }
</div>

<div class="grid grid-2">
    <div class="card">
        <div class="section-tag">Standing instructions</div>
        <textarea @bind="_settings.Instructions" rows="18"
                  placeholder="How code should be written here. Conventions, the stack, what to avoid, how to commit and open a PR."></textarea>
        <div class="btn-row" style="margin-top:0.6rem">
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save standards</button>
            <span class="mono-dim">Applied on the next turn of every session.</span>
        </div>
    </div>

    <div class="card">
        <div class="section-tag">Reference files</div>
        <p class="small">
            Copied into every workspace. Keep them small enough to be worth reading — a standards
            document, a setup guide, a schema.
        </p>

        <InputFile OnChange="UploadAsync" multiple class="btn btn-sm" />

        @if (_uploading)
        {
            <p class="mono-dim">Uploading…</p>
        }

        <div class="table-wrap" style="margin-top:0.8rem">
            <table class="table">
                <thead>
                <tr><th>File</th><th>Size</th><th>Uploaded</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var file in _settings.Files.OrderBy(f => f.FileName))
                {
                    <tr>
                        <td>
                            @file.FileName
                            @if (file.IsText)
                            {
                                <button class="btn btn-sm btn-ghost" @onclick="() => PreviewAsync(file)">peek</button>
                            }
                        </td>
                        <td class="mono-dim">@Size(file.SizeBytes)</td>
                        <td class="mono-dim">@file.UploadedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                        <td>
                            <div class="btn-row">
                                <a class="btn btn-sm btn-ghost" href="/files/global/@file.FileName" target="_blank">Download</a>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(file)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
                @if (_settings.Files.Count == 0)
                {
                    <tr><td colspan="4" class="mono-dim">No files yet.</td></tr>
                }
                </tbody>
            </table>
        </div>

        @if (_preview is not null)
        {
            <div class="divider"></div>
            <div class="section-tag">@_previewName</div>
            <pre class="small" style="white-space:pre-wrap;max-height:320px;overflow-y:auto">@_preview</pre>
            <button class="btn btn-sm btn-ghost" @onclick="() => _preview = null">Close preview</button>
        }
    </div>
</div>

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private GlobalSettings _settings = new();
    private List<Project> _optedOut = [];
    private string? _preview;
    private string _previewName = string.Empty;
    private bool _uploading;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Standards", "Setup and coding rules every agent inherits");
    }

    private async Task ReloadAsync()
    {
        _settings = await SettingsStore.GetAsync(GlobalSettings.WellKnownId) ?? new GlobalSettings();

        var projects = await ProjectStore.GetAllAsync();
        _optedOut = projects.Where(p => !p.Archived && !p.InheritGlobalInstructions).ToList();
    }

    private async Task SaveAsync()
    {
        await SettingsStore.UpsertAsync(_settings);
        Layout.Notify("Standards saved.", "ok");
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        _uploading = true;
        try
        {
            // The settings record must exist before a file can be attached to it.
            await SettingsStore.UpsertAsync(_settings);

            foreach (var file in args.GetMultipleFiles(20))
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
                await Files.SaveAsync(FileScope.Global, file.Name, stream, file.ContentType);
            }

            await ReloadAsync();
            Layout.Notify("Files uploaded.", "ok");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DeleteAsync(StoredFile file)
    {
        await Files.DeleteAsync(FileScope.Global, file.Id);
        _preview = null;
        await ReloadAsync();
    }

    private async Task PreviewAsync(StoredFile file)
    {
        _previewName = file.FileName;
        _preview = await Files.ReadTextAsync(FileScope.Global, file.Id) ?? "(not previewable)";
    }

    private static string Size(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };
}
