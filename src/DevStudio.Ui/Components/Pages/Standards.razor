@page "/standards"
@inject IEntityStore<GlobalSettings> SettingsStore
@inject IEntityStore<Project> ProjectStore
@inject IEntityStore<GitRepository> RepositoryStore
@inject IFileLibraryService Files
@inject IStandardsFilesSyncService StandardsSync

<PageTitle>Standards · devStudio</PageTitle>

<div class="card" style="margin-bottom:1.2rem">
    <div class="section-tag">What this is</div>
    <p class="small">
        The house rules. Everything here goes into the system prompt of every session, underneath the
        project's own instructions, and every uploaded file is staged into
        <code>./global-files</code> in each agent's working directory. Put your setup guide, coding
        standards and architecture notes here once instead of repeating them in every project.
    </p>
    @if (_optedOut.Count > 0)
    {
        <div class="mono-dim">
            Not applied in: @string.Join(", ", _optedOut.Select(p => p.Name))
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_settings.TeamInstructions))
{
    <div class="card" style="margin-bottom:1.2rem">
        <div class="section-tag">From the team settings repository</div>
        <p class="small">
            Applied above your own instructions in every session, so what you write below reads as the
            narrower rule. Edit these in the repository — the next sync writes this copy back over.
            <a href="/team-settings">Team settings</a>
        </p>
        <pre class="small" style="white-space:pre-wrap">@_settings.TeamInstructions</pre>
    </div>
}

<div class="grid grid-2">
    <div class="card">
        <div class="section-tag">Standing instructions</div>
        <textarea @bind="_settings.Instructions" rows="18"
                  placeholder="How code should be written here. Conventions, the stack, what to avoid, how to commit and open a PR."></textarea>
        <div class="btn-row" style="margin-top:0.6rem">
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save standards</button>
            <span class="mono-dim">Applied on the next turn of every session.</span>
        </div>
    </div>

    <div class="card">
        <div class="section-tag">Reference files</div>
        <p class="small">
            Copied into every workspace. Keep them small enough to be worth reading — a standards
            document, a setup guide, a schema.
        </p>

        <div class="divider"></div>
        <div class="section-tag">Source from a repository</div>

        @if (_repositories.Count == 0)
        {
            <p class="mono-dim">
                No repositories yet. Clone or attach one on the
                <a href="/repositories">Repositories</a> page first.
            </p>
        }
        else
        {
            <div class="form-grid">
                <div class="field">
                    <label>Repository</label>
                    <select value="@(_settings.FilesRepositoryId ?? string.Empty)"
                            @onchange="e => _settings.FilesRepositoryId = Blank(e.Value?.ToString())">
                        <option value="">None — uploaded files only</option>
                        @foreach (var repository in _repositories)
                        {
                            <option value="@repository.Id">@repository.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Folder in the repository</label>
                    <input type="text" @bind="_settings.FilesFolder" placeholder="standards" />
                    <span class="hint">Blank for the repository root. Every file directly in the folder is imported.</span>
                </div>
            </div>

            <label class="check">
                <input type="checkbox" @bind="_settings.FilesPullBeforeSync" />
                <span>Pull before reading, so a sync is never stale</span>
            </label>

            <div class="mono-dim" style="margin-top:0.4rem">
                Also pulled automatically every 15 minutes and before every new session starts — a
                failed pull never blocks a conversation, it just keeps the last checkout.
            </div>

            <div class="btn-row" style="margin-top:0.8rem">
                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveAsync">Save</button>
                <button class="btn btn-sm" disabled="@(_busy || _settings.FilesRepositoryId is null)" @onclick="SyncAsync">
                    @(_syncing ? "Syncing…" : "Sync now")
                </button>
            </div>

            <div class="mono-dim" style="margin-top:0.6rem">
                @if (_settings.FilesLastSyncedAt is { } synced)
                {
                    <text>Last synced <LocalTime Value="@synced" Format="daytime" />.</text>
                }
                else
                {
                    <text>Never synced.</text>
                }
            </div>

            @if (_settings.FilesLastError is { Length: > 0 } error)
            {
                <div class="toast err" style="margin-top:0.7rem">@error</div>
            }
        }

        <div class="divider"></div>

        <InputFile OnChange="UploadAsync" multiple class="btn btn-sm" />

        @if (_uploading)
        {
            <p class="mono-dim">Uploading…</p>
        }

        <div class="table-wrap" style="margin-top:0.8rem">
            <table class="table">
                <thead>
                <tr><th>File</th><th>Size</th><th>Uploaded</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var file in _settings.Files.OrderBy(f => f.FileName))
                {
                    <tr>
                        <td>
                            @file.FileName
                            @if (file.TeamSourcePath is { Length: > 0 })
                            {
                                <span class="pill" title="Synced from the repository — the next sync writes it back over">repo</span>
                            }
                            @if (file.IsText)
                            {
                                <button class="btn btn-sm btn-ghost" @onclick="() => PreviewAsync(file)">peek</button>
                            }
                        </td>
                        <td class="mono-dim">@Size(file.SizeBytes)</td>
                        <td class="mono-dim"><LocalTime Value="@file.UploadedAt" Format="daytime" /></td>
                        <td>
                            <div class="btn-row">
                                <a class="btn btn-sm btn-ghost" href="/files/global/@file.FileName" target="_blank">Download</a>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(file)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
                @if (_settings.Files.Count == 0)
                {
                    <tr><td colspan="4" class="mono-dim">No files yet.</td></tr>
                }
                </tbody>
            </table>
        </div>

        @if (_preview is not null)
        {
            <div class="divider"></div>
            <div class="section-tag">@_previewName</div>
            <pre class="small" style="white-space:pre-wrap;max-height:320px;overflow-y:auto">@_preview</pre>
            <button class="btn btn-sm btn-ghost" @onclick="() => _preview = null">Close preview</button>
        }
    </div>
</div>

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private GlobalSettings _settings = new();
    private List<Project> _optedOut = [];
    private IReadOnlyList<GitRepository> _repositories = [];
    private string? _preview;
    private string _previewName = string.Empty;
    private bool _uploading;
    private bool _saving;
    private bool _syncing;

    private bool _busy => _saving || _syncing;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Standards", "Setup and coding rules every agent inherits");
    }

    private async Task ReloadAsync()
    {
        _settings = await SettingsStore.GetAsync(GlobalSettings.WellKnownId) ?? new GlobalSettings();
        _repositories = await RepositoryStore.GetAllAsync();

        var projects = await ProjectStore.GetAllAsync();
        _optedOut = projects.Where(p => !p.Archived && !p.InheritGlobalInstructions).ToList();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await SettingsStore.UpsertAsync(_settings);
            Layout.Notify("Standards saved.", "ok");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SyncAsync()
    {
        // Saved first, or a sync would read the repository the page is no longer showing.
        await SettingsStore.UpsertAsync(_settings);

        _syncing = true;
        try
        {
            var result = await StandardsSync.SyncAsync();
            await ReloadAsync();
            Layout.Notify(result.Message, result.Succeeded ? "ok" : "err");
        }
        finally
        {
            _syncing = false;
        }
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        _uploading = true;
        try
        {
            // The settings record must exist before a file can be attached to it.
            await SettingsStore.UpsertAsync(_settings);

            foreach (var file in args.GetMultipleFiles(20))
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
                await Files.SaveAsync(FileScope.Global, file.Name, stream, file.ContentType);
            }

            await ReloadAsync();
            Layout.Notify("Files uploaded.", "ok");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DeleteAsync(StoredFile file)
    {
        await Files.DeleteAsync(FileScope.Global, file.Id);
        _preview = null;
        await ReloadAsync();
    }

    private async Task PreviewAsync(StoredFile file)
    {
        _previewName = file.FileName;
        _preview = await Files.ReadTextAsync(FileScope.Global, file.Id) ?? "(not previewable)";
    }

    private static string Size(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };
}
