@page "/projects/{ProjectId}"
@inject IEntityStore<Project> ProjectStore
@inject IEntityStore<Agent> AgentStore
@inject IEntityStore<Workflow> WorkflowStore
@inject IFileLibraryService Files
@inject ISessionManager Sessions
@inject IWorkflowEngine Workflows
@inject NavigationManager Nav

<PageTitle>@(_project?.Name ?? "Project") · DevStudio</PageTitle>

@if (_project is null)
{
    <div class="empty">That project no longer exists.</div>
}
else
{
    <div class="grid grid-2">
        <div>
            <div class="card" style="margin-bottom:1.2rem">
                <div class="section-tag">Instructions</div>
                <textarea @bind="_project.Instructions" rows="10"
                          placeholder="Everything an agent should know before it starts."></textarea>
                <div class="btn-row" style="margin-top:0.6rem">
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save</button>
                    <span class="mono-dim">Injected into the system prompt of every session in this project.</span>
                </div>
            </div>

            <div class="card">
                <div class="section-tag">Files</div>
                <p class="small">
                    Uploaded files are copied into <code>./project-files</code> in the working directory of
                    every session in this project.
                </p>

                <InputFile OnChange="UploadAsync" multiple class="btn btn-sm" />

                @if (_uploading)
                {
                    <p class="mono-dim">Uploading…</p>
                }

                <div class="table-wrap" style="margin-top:0.8rem">
                    <table class="table">
                        <thead>
                        <tr><th>File</th><th>Size</th><th>Uploaded</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var file in _project.Files.OrderBy(f => f.FileName))
                        {
                            <tr>
                                <td>@file.FileName</td>
                                <td class="mono-dim">@Size(file.SizeBytes)</td>
                                <td class="mono-dim">@file.UploadedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                <td>
                                    <div class="btn-row">
                                        <a class="btn btn-sm btn-ghost" href="/files/@_project.Id/@file.FileName" target="_blank">Download</a>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteFileAsync(file)">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (_project.Files.Count == 0)
                        {
                            <tr><td colspan="4" class="mono-dim">No files uploaded.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div>
            <div class="card" style="margin-bottom:1.2rem">
                <div class="section-tag">Run in this project</div>

                <div class="tabs">
                    <button class="tab @(_runMode == "agent" ? "active" : "")" @onclick='() => _runMode = "agent"'>Agent</button>
                    <button class="tab @(_runMode == "workflow" ? "active" : "")" @onclick='() => _runMode = "workflow"'>Workflow</button>
                </div>

                @if (_runMode == "agent")
                {
                    <div class="field">
                        <label>Agent</label>
                        <select @bind="_agentId">
                            @foreach (var agent in _agents.Where(a => a.Enabled))
                            {
                                <option value="@agent.Id">@agent.Name — @agent.Provider</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Prompt</label>
                        <textarea @bind="_prompt" rows="5" placeholder="What should happen in this project?"></textarea>
                    </div>
                    <div class="btn-row">
                        <button class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(_prompt) || _agentId is null)"
                                @onclick="RunAgentAsync">Start session</button>
                        <a class="btn btn-ghost" href="/schedules">Schedule it</a>
                    </div>
                }
                else
                {
                    <div class="field">
                        <label>Workflow</label>
                        <select @bind="_workflowId">
                            @foreach (var workflow in _workflows.Where(w => w.Enabled))
                            {
                                <option value="@workflow.Id">@workflow.Name</option>
                            }
                        </select>
                    </div>
                    @if (SelectedWorkflow is { } selected)
                    {
                        @foreach (var input in selected.Inputs)
                        {
                            <div class="field">
                                <label>@input.Name</label>
                                <input type="text" value="@GetInput(input.Name)"
                                       @onchange="e => SetInput(input.Name, e.Value?.ToString())"
                                       placeholder="@input.Description" />
                            </div>
                        }
                    }
                    <div class="btn-row">
                        <button class="btn btn-primary" disabled="@(_workflowId is null)" @onclick="RunWorkflowAsync">Run workflow</button>
                    </div>
                }
            </div>

            <div class="section-tag">Sessions in this project</div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr><th>Title</th><th>Agent</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var session in _sessions)
                    {
                        <tr style="cursor:pointer" @onclick="() => OpenSession(session)">
                            <td>@session.Title</td>
                            <td class="mono-dim">@session.AgentName</td>
                            <td><StatusPill Session="session.Status" /></td>
                        </tr>
                    }
                    @if (_sessions.Count == 0)
                    {
                        <tr><td colspan="3" class="mono-dim">Nothing has run in this project yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private Project? _project;
    private IReadOnlyList<Agent> _agents = [];
    private IReadOnlyList<Workflow> _workflows = [];
    private List<ChatSession> _sessions = [];
    private readonly Dictionary<string, string> _inputs = [];

    private string _runMode = "agent";
    private string? _agentId;
    private string? _workflowId;
    private string _prompt = string.Empty;
    private bool _uploading;

    private Workflow? SelectedWorkflow => _workflows.FirstOrDefault(w => w.Id == _workflowId);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader(_project?.Name ?? "Project", "Project workspace");
    }

    private async Task ReloadAsync()
    {
        _project = await ProjectStore.GetAsync(ProjectId);
        _agents = await AgentStore.GetAllAsync();
        _workflows = await WorkflowStore.GetAllAsync();
        _agentId ??= _agents.FirstOrDefault(a => a.Enabled)?.Id;
        _workflowId ??= _workflows.FirstOrDefault()?.Id;

        var all = await Sessions.GetAllAsync();
        _sessions = all.Where(s => s.ProjectId == ProjectId && !s.IsArchived).Take(20).ToList();
    }

    private async Task SaveAsync()
    {
        if (_project is null)
            return;

        await ProjectStore.UpsertAsync(_project);
        Layout.Notify("Instructions saved.", "ok");
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        if (_project is null)
            return;

        _uploading = true;
        try
        {
            foreach (var file in args.GetMultipleFiles(20))
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
                await Files.SaveAsync(FileScope.Project(_project.Id), file.Name, stream, file.ContentType);
            }

            await ReloadAsync();
            Layout.Notify("Files uploaded.", "ok");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DeleteFileAsync(StoredFile file)
    {
        if (_project is null)
            return;

        await Files.DeleteAsync(FileScope.Project(_project.Id), file.Id);
        await ReloadAsync();
    }

    private async Task RunAgentAsync()
    {
        if (_agentId is null || string.IsNullOrWhiteSpace(_prompt))
            return;

        try
        {
            var session = await Sessions.StartAsync(new StartSessionRequest
            {
                AgentId = _agentId,
                Prompt = _prompt.Trim(),
                ProjectId = ProjectId,
            });

            Nav.NavigateTo($"/chat/{session.Id}");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
    }

    private async Task RunWorkflowAsync()
    {
        if (_workflowId is null)
            return;

        try
        {
            var inputs = new Dictionary<string, string>(_inputs) { ["projectId"] = ProjectId };
            var run = await Workflows.StartAsync(_workflowId, inputs, "project");
            Nav.NavigateTo($"/workflows/runs/{run.Id}");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
    }

    private string GetInput(string name) => _inputs.TryGetValue(name, out var value) ? value : string.Empty;

    private void SetInput(string name, string? value) => _inputs[name] = value ?? string.Empty;

    private void OpenSession(ChatSession session) => Nav.NavigateTo($"/chat/{session.Id}");

    private static string Size(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };
}
