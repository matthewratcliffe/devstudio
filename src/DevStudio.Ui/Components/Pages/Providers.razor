@page "/providers"
@implements IAsyncDisposable
@inject IProviderCliRegistry Clis
@inject IAccountService Accounts
@inject IEntityStore<ProviderAccount> AccountStore
@inject IEntityStore<Project> ProjectStore
@inject ISourceControlRegistry Forges
@inject ISourceControlHosts ForgeHosts
@inject ITerminalService Terminals
@inject ILoopbackCallbackForwarder Callbacks
@inject IJSRuntime Js

<PageTitle>Logins · DevStudio</PageTitle>

<div class="card" style="margin-bottom:1.2rem">
    <div class="section-tag">How this works</div>
    <p class="small">
        There is no API key anywhere in this app — every agent runs the real CLI, so the CLI's own login
        is what matters. Each account is a separate home directory on the volume, which is what lets a
        personal and a work login coexist: pick one per project, and the session's CLI runs with that
        account's credentials.
    </p>
</div>

@foreach (var cli in _clis)
{
    <div class="card-head" style="margin-top:0.6rem">
        <h3>@cli.DisplayName</h3>
        <div class="spacer"></div>
        <button class="btn btn-sm btn-primary" @onclick="() => StartAddAccount(cli)">Add account</button>
        <button class="btn btn-sm btn-ghost" @onclick="RefreshAsync">Refresh</button>
    </div>

    <div class="grid grid-3" style="margin-bottom:1.4rem">
        @foreach (var account in _accounts.Where(a => a.Provider == cli.Provider && a.CliProviderId == cli.DefinitionId))
        {
            <div class="card">
                <div class="card-head">
                    <h3>@account.Name</h3>
                    <div class="spacer"></div>
                    <StatusPill Auth="account.LastKnownState" />
                </div>

                <p class="small mono-dim" style="margin-bottom:0.5rem">@account.HomePath</p>

                <div class="btn-row" style="margin-bottom:0.7rem">
                    @if (account.IsDefault)
                    {
                        <span class="pill pill-cyan"><span class="dot"></span>default</span>
                    }
                    <span class="pill">@ProjectsUsing(account) projects</span>
                </div>

                @if (cli.SupportedLoginMethods.Count == 0)
                {
                    <p class="small mono-dim">
                        This CLI has no sign-in command configured. Add one on the
                        <a href="/cli-providers">CLI providers</a> page, or sign in from a shell.
                    </p>
                }
                <div class="field" style="margin-bottom:0.6rem" hidden="@(cli.SupportedLoginMethods.Count == 0)">
                    <label>Sign-in method</label>
                    <select value="@MethodFor(account.Id, cli.SupportedLoginMethods)"
                            @onchange="e => SetMethod(account.Id, e.Value?.ToString())">
                        @foreach (var method in cli.SupportedLoginMethods)
                        {
                            <option value="@method">@method.Describe()</option>
                        }
                    </select>
                    <span class="hint">@MethodHint(MethodFor(account.Id, cli.SupportedLoginMethods))</span>
                </div>

                <div class="btn-row">
                    <button class="btn btn-sm btn-primary" @onclick="() => StartLoginAsync(account, cli.SupportedLoginMethods)">Log in</button>
                    <button class="btn btn-sm btn-ghost" @onclick="() => StartLogoutAsync(account)">Log out</button>
                    @if (!account.IsDefault)
                    {
                        <button class="btn btn-sm btn-ghost" @onclick="() => MakeDefaultAsync(account)">Make default</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(account)">Delete</button>
                    }
                </div>
            </div>
        }
    </div>
}

<div class="section-tag" style="margin-top:1rem">Source control</div>
<p class="small">
    One login per forge, shared by every agent — it is what makes private clones and
    <code>gh pr create</code> or <code>glab mr create</code> work.
</p>

<div class="grid grid-2" style="margin-bottom:1.4rem">
    @foreach (var forge in Forges.All)
    {
        <div class="card">
            <div class="card-head">
                <h3>@forge.DisplayName</h3>
                <div class="spacer"></div>
                <StatusPill Auth="@(_forgeState.TryGetValue(forge.Provider, out var state) ? state : ProviderAuthState.Unknown)" />
            </div>

            <p class="small mono-dim">@(_forgeDetail.TryGetValue(forge.Provider, out var detail) ? detail : string.Empty)</p>

            <div class="field">
                <label>Hostname</label>
                <div style="display:flex;gap:0.5rem">
                    <input type="text" style="flex:1" value="@HostFor(forge)"
                           @onchange="e => _hostDrafts[forge.Provider] = e.Value?.ToString() ?? string.Empty"
                           placeholder="@(forge.Provider == SourceControlProvider.GitLab ? "gitlab.com" : "github.com")" />
                    <button class="btn btn-sm" @onclick="() => SaveHostAsync(forge)">Save</button>
                </div>
                <span class="hint">
                    Point this at a self-managed instance — <code>gitlab.mycompany.com</code>. A full URL is
                    accepted and reduced to the host. Sign in again after changing it.
                </span>
            </div>

            <div class="field">
                <label>Sign-in method</label>
                <select value="@ForgeMethod(forge)" @onchange="e => SetForgeMethod(forge.Provider, e.Value?.ToString())">
                    @foreach (var method in forge.SupportedLoginMethods)
                    {
                        <option value="@method">@method.Describe()</option>
                    }
                </select>
                <span class="hint">@MethodHint(ForgeMethod(forge))</span>
            </div>

            <div class="btn-row">
                <button class="btn btn-sm btn-primary" @onclick="() => StartForgeLoginAsync(forge)">Log in</button>
                <button class="btn btn-sm btn-ghost" @onclick="RefreshAsync">Refresh</button>
            </div>
        </div>
    }
</div>

@if (_session is not null)
{
    <div class="terminal">
        <div class="terminal-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="title">@_sessionCommand</span>
            <div style="flex:1"></div>
            <button class="btn btn-sm btn-ghost" @onclick="SendCtrlCAsync">Ctrl+C</button>
            <button class="btn btn-sm btn-danger" @onclick="CloseTerminalAsync">Close</button>
        </div>

        @if (_terminalAccount is not null)
        {
            <div style="padding:0.5rem 1rem;border-bottom:1px solid var(--border);background:var(--bg-2)" class="mono-dim">
                Running as <strong>@_terminalAccount.Name</strong> · HOME=@_terminalAccount.HomePath
            </div>
        }

        @if (_session.DetectedCodes.Count > 0)
        {
            <div style="padding:0.7rem 1rem;border-bottom:1px solid var(--border);background:var(--bg-2)">
                <div class="section-tag" style="margin-bottom:0.4rem">Then enter this one-time code</div>
                @foreach (var oneTimeCode in _session.DetectedCodes)
                {
                    <div style="margin-bottom:0.3rem;display:flex;align-items:center;gap:0.6rem">
                        <span style="font-size:1.3rem;font-weight:700;letter-spacing:0.12em" class="text-gradient">@oneTimeCode</span>
                        <button class="btn btn-sm btn-ghost" @onclick="() => CopyAsync(oneTimeCode)">Copy</button>
                    </div>
                }
            </div>
        }

        @if (_session.DetectedUrls.Count > 0)
        {
            <div style="padding:0.7rem 1rem;border-bottom:1px solid var(--border);background:var(--bg-2)">
                <div class="section-tag" style="margin-bottom:0.4rem">Open this to authorise</div>
                @foreach (var url in _session.DetectedUrls)
                {
                    <div style="margin-bottom:0.3rem">
                        <a href="@url" target="_blank" rel="noopener">@url</a>
                        <button class="btn btn-sm btn-ghost" @onclick="() => CopyAsync(url)">Copy</button>
                    </div>
                }
            </div>
        }

        <div class="terminal-body">@_session.Buffer</div>

        @if (_terminalMethod == LoginMethod.Browser && _terminalAccount?.Provider == AiProvider.Codex)
        {
            <div style="padding:0.7rem 1rem;border-bottom:1px solid var(--border);background:var(--bg-2)">
                <div class="section-tag" style="margin-bottom:0.4rem">If the browser cannot reach the callback</div>
                <p class="small" style="margin-bottom:0.5rem">
                    Codex always redirects to <code>http://localhost:@Callbacks.CallbackPort/auth/callback</code>,
                    which only resolves on the machine running the container. Either change the port in your
                    browser's address bar to <strong>@AppPort</strong>, or paste the whole failed URL here and
                    it will be delivered for you.
                </p>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                    <input type="text" style="flex:1;min-width:280px" @bind="_callbackUrl" @bind:event="oninput"
                           @onkeydown="OnCallbackKeyDown"
                           placeholder="http://localhost:@Callbacks.CallbackPort/auth/callback?code=..." />
                    <button class="btn btn-sm btn-primary" disabled="@string.IsNullOrWhiteSpace(_callbackUrl)"
                            @onclick="ForwardCallbackAsync">Deliver callback</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_callbackStatus))
                {
                    <div class="mono-dim" style="margin-top:0.4rem">@_callbackStatus</div>
                }
            </div>
        }

        @if (_terminalMethod.NeedsSecret())
        {
            <div class="terminal-input">
                <span class="prompt">🔑</span>
                <input type="password" @bind="_secret" @bind:event="oninput" @onkeydown="OnSecretKeyDown"
                       placeholder="Paste your key or token here — it goes straight to the CLI and is never stored by this app." />
                <button class="btn btn-sm btn-primary" disabled="@string.IsNullOrWhiteSpace(_secret)"
                        @onclick="SendSecretAsync">Send token</button>
            </div>
        }

        <div class="terminal-input">
            <span class="prompt">&gt;</span>
            <input type="text" @bind="_input" @bind:event="oninput" @onkeydown="OnKeyDown"
                   placeholder="Open the link above, then paste the code it gives you here and press Enter." />
            <button class="btn btn-sm btn-primary" @onclick="SendAsync">Send</button>
            <button class="btn btn-sm btn-ghost" title="Answer a yes/no prompt"
                    @onclick='() => SendRawAsync("Y")'>Y</button>
            <button class="btn btn-sm btn-ghost" title="Answer a yes/no prompt"
                    @onclick='() => SendRawAsync("n")'>n</button>
            <button class="btn btn-sm btn-ghost" title="Send a bare newline"
                    @onclick="() => SendRawAsync(string.Empty)">Enter</button>
        </div>
    </div>
}

@if (_newAccountProvider is not null)
{
    <div class="modal-backdrop" @onclick="() => _newAccountProvider = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>New account</h2>
            <p class="small">
                This creates an empty credential directory. Log into it afterwards, then pick it on the
                projects that should use it.
            </p>
            <div class="field">
                <label>Name</label>
                <input type="text" @bind="_newAccountName" placeholder="Work, Personal, Client X" />
            </div>
            <div class="btn-row">
                <button class="btn btn-primary" @onclick="CreateAccountAsync">Create account</button>
                <button class="btn btn-ghost" @onclick="() => _newAccountProvider = null">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<IProviderCli> _clis = [];
    private IReadOnlyList<ProviderAccount> _accounts = [];
    private IReadOnlyList<Project> _projects = [];
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private readonly Dictionary<SourceControlProvider, ProviderAuthState> _forgeState = [];
    private readonly Dictionary<SourceControlProvider, string> _forgeDetail = [];
    private readonly Dictionary<SourceControlProvider, LoginMethod> _forgeMethods = [];
    private readonly Dictionary<SourceControlProvider, string> _hostDrafts = [];

    private ITerminalSession? _session;
    private ProviderAccount? _terminalAccount;
    private string _sessionCommand = string.Empty;
    private string _input = string.Empty;
    private string _secret = string.Empty;
    private string _callbackUrl = string.Empty;
    private string _callbackStatus = string.Empty;

    /// <summary>Chosen sign-in flow per account.</summary>
    private readonly Dictionary<string, LoginMethod> _methods = [];
    private LoginMethod _terminalMethod = LoginMethod.Browser;

    private AiProvider? _newAccountProvider;
    private string? _newAccountCliId;
    private string _newAccountName = string.Empty;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Logins", "One account per login — pick which one each project uses");
    }

    private async Task RefreshAsync()
    {
        _clis = await Clis.GetAllAsync();
        _accounts = await Accounts.RefreshAuthStateAsync();
        _projects = await ProjectStore.GetAllAsync();
        foreach (var forge in Forges.All)
        {
            _forgeState[forge.Provider] = await forge.GetAuthStateAsync();
            _forgeDetail[forge.Provider] = FirstLine(await forge.GetAuthStatusTextAsync());
        }
    }

    private void StartAddAccount(IProviderCli cli)
    {
        _newAccountProvider = cli.Provider;
        _newAccountCliId = cli.DefinitionId;
        _newAccountName = string.Empty;
    }

    private async Task CreateAccountAsync()
    {
        if (_newAccountProvider is null)
            return;

        try
        {
            var account = await Accounts.CreateAsync(_newAccountName, _newAccountProvider.Value, _newAccountCliId);
            _newAccountProvider = null;
            await RefreshAsync();
            Layout.Notify($"Created {account.Name}. Log into it to finish.", "ok");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
    }

    private async Task MakeDefaultAsync(ProviderAccount account)
    {
        foreach (var other in _accounts.Where(a => a.Provider == account.Provider && a.IsDefault))
        {
            other.IsDefault = false;
            await AccountStore.UpsertAsync(other);
        }

        account.IsDefault = true;
        await AccountStore.UpsertAsync(account);
        await RefreshAsync();
    }

    private async Task DeleteAsync(ProviderAccount account)
    {
        var inUse = ProjectsUsing(account);
        if (inUse > 0)
        {
            Layout.Notify($"{inUse} project(s) still use that account. Move them first.", "err");
            return;
        }

        // The credentials go with it — the account exists only to hold them.
        await Accounts.DeleteAsync(account.Id, deleteCredentials: true);
        await RefreshAsync();
        Layout.Notify($"Deleted {account.Name}.", "ok");
    }

    private LoginMethod MethodFor(string accountId, IReadOnlyList<LoginMethod> supported) =>
        _methods.TryGetValue(accountId, out var method) && supported.Contains(method)
            ? method
            : supported.FirstOrDefault();

    private void SetMethod(string accountId, string? value)
    {
        if (Enum.TryParse<LoginMethod>(value, out var method))
            _methods[accountId] = method;
    }

    private string HostFor(ISourceControlCli forge) =>
        _hostDrafts.TryGetValue(forge.Provider, out var draft) ? draft : forge.Host;

    private async Task SaveHostAsync(ISourceControlCli forge)
    {
        var host = _hostDrafts.TryGetValue(forge.Provider, out var draft) ? draft : forge.Host;

        await ForgeHosts.SetAsync(forge.Provider, host);
        _hostDrafts.Remove(forge.Provider);

        await RefreshAsync();
        Layout.Notify($"{forge.DisplayName} now points at {forge.Host}.", "ok");
    }

    private LoginMethod ForgeMethod(ISourceControlCli forge) =>
        _forgeMethods.TryGetValue(forge.Provider, out var method) && forge.SupportedLoginMethods.Contains(method)
            ? method
            : forge.SupportedLoginMethods.FirstOrDefault();

    private void SetForgeMethod(SourceControlProvider provider, string? value)
    {
        if (Enum.TryParse<LoginMethod>(value, out var method))
            _forgeMethods[provider] = method;
    }

    private static string MethodHint(LoginMethod method) => method switch
    {
        LoginMethod.Browser =>
            "Opens a sign-in link. Codex redirects to a callback on port 1455 — this app can take that callback for you, so it works from any browser.",
        LoginMethod.DeviceCode =>
            "Shows a link and a short code to type into the browser. Works from anywhere — nothing has to reach back into the container.",
        LoginMethod.Token =>
            "Paste a key or token. The CLI stores it in its own credential store; this app never keeps a copy.",
        LoginMethod.Console =>
            "Sign in with an Anthropic Console account, billed by API usage rather than a subscription.",
        LoginMethod.LongLivedToken =>
            "Runs claude setup-token, which mints a long-lived credential through the browser. Best for schedules and workflows that run unattended.",
        _ => string.Empty,
    };

    private async Task StartLoginAsync(ProviderAccount account, IReadOnlyList<LoginMethod> supported)
    {
        await CloseTerminalAsync(refresh: false);

        var method = MethodFor(account.Id, supported);
        var cli = await Clis.ResolveAsync(account.Provider, account.CliProviderId);
        var (fileName, arguments) = cli.BuildLoginCommand(method);
        var home = await Accounts.GetHomePathAsync(account.Id);

        await OpenTerminalAsync(account, fileName, arguments, home, method);
    }

    private async Task StartLogoutAsync(ProviderAccount account)
    {
        await CloseTerminalAsync(refresh: false);

        var cli = await Clis.ResolveAsync(account.Provider, account.CliProviderId);
        var (fileName, arguments) = cli.BuildLogoutCommand();
        var home = await Accounts.GetHomePathAsync(account.Id);

        await OpenTerminalAsync(account, fileName, arguments, home, LoginMethod.Browser);
    }

    private async Task StartForgeLoginAsync(ISourceControlCli forge)
    {
        await CloseTerminalAsync(refresh: false);

        var method = ForgeMethod(forge);
        var (fileName, arguments) = forge.BuildLoginCommand(method);
        await OpenTerminalAsync(null, fileName, arguments, null, method);
    }

    private async Task OpenTerminalAsync(
        ProviderAccount? account,
        string fileName,
        IReadOnlyList<string> arguments,
        string? home,
        LoginMethod method)
    {
        // HOME is the whole mechanism: the CLI writes its credentials wherever we point it.
        var environment = home is null
            ? null
            : new Dictionary<string, string>
            {
                ["HOME"] = home,
                ["CODEX_HOME"] = Path.Combine(home, ".codex"),
            };

        _session = await Terminals.StartAsync(fileName, arguments, home, environment);
        _terminalAccount = account;
        _terminalMethod = method;
        _secret = string.Empty;
        _sessionCommand = $"{fileName} {string.Join(' ', arguments)}".Trim();
        _session.Updated += OnTerminalUpdated;
    }

    private async Task SendAsync()
    {
        if (_session is null || string.IsNullOrEmpty(_input))
            return;

        var text = _input;
        _input = string.Empty;
        await _session.SendAsync(text);
    }

    /// <summary>The port this app is reachable on, so the hint can name it.</summary>
    private string AppPort => new Uri(Nav.BaseUri).Port.ToString();

    private async Task ForwardCallbackAsync()
    {
        if (string.IsNullOrWhiteSpace(_callbackUrl))
            return;

        var result = await Callbacks.ForwardAsync(_callbackUrl.Trim());
        _callbackStatus = result.Detail;

        if (result.Succeeded)
        {
            _callbackUrl = string.Empty;
            Layout.Notify("Callback delivered.", "ok");
        }
        else
        {
            Layout.Notify(result.Detail, "err");
        }
    }

    private async Task OnCallbackKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ForwardCallbackAsync();
    }

    private async Task SendSecretAsync()
    {
        if (_session is null || string.IsNullOrWhiteSpace(_secret))
            return;

        var secret = _secret.Trim();
        _secret = string.Empty;

        await _session.SendSecretAsync(secret);
        Layout.Notify("Token sent to the CLI.", "ok");
    }

    private async Task OnSecretKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SendSecretAsync();
    }

    private async Task SendRawAsync(string text)
    {
        if (_session is not null)
            await _session.SendAsync(text);
    }

    private async Task SendCtrlCAsync()
    {
        if (_session is not null)
            await _session.SendControlAsync('c');
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SendAsync();
    }

    private async Task CopyAsync(string url)
    {
        await Js.InvokeAsync<bool>("aiShop.copy", url);
        Layout.Notify("Copied.", "ok");
    }

    private async Task CloseTerminalAsync() => await CloseTerminalAsync(refresh: true);

    private async Task CloseTerminalAsync(bool refresh)
    {
        if (_session is null)
            return;

        _session.Updated -= OnTerminalUpdated;
        await Terminals.CloseAsync(_session.Id);
        _session = null;
        _terminalAccount = null;

        if (refresh)
            await RefreshAsync();
    }

    private int ProjectsUsing(ProviderAccount account) => _projects.Count(p =>
        p.ClaudeAccountId == account.Id || p.CodexAccountId == account.Id);

    private void OnTerminalUpdated() => InvokeAsync(StateHasChanged);

    private static string FirstLine(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim() ?? text;

    public async ValueTask DisposeAsync() => await CloseTerminalAsync(refresh: false);
}
