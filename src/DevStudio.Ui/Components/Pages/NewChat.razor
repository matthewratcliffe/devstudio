@page "/agents/{AgentId}/chat"
@inject IEntityStore<Agent> AgentStore
@inject IEntityStore<Project> ProjectStore
@inject ISessionManager Sessions
@inject NavigationManager Nav

<PageTitle>New session · devStudio</PageTitle>

@if (_agent is null)
{
    <div class="empty">That agent no longer exists.</div>
}
else
{
    <div class="card" style="max-width:820px">
        <div class="section-tag">New session</div>
        <h2>@_agent.Name</h2>
        <p class="small">@_agent.Description</p>

        <div class="btn-row" style="margin-bottom:1rem">
            <span class="pill @(_agent.Provider == AiProvider.Claude ? "pill-cyan" : "pill-magenta")">
                <span class="dot"></span>@_agent.Provider
            </span>
            <span class="pill">@_agent.PermissionMode</span>
            @if (_agent.UseWorktree && _agent.RepositoryId is not null)
            {
                <span class="pill">fresh worktree</span>
            }
        </div>

        <div class="field">
            <label>Project</label>
            <select @bind="_projectId">
                <option value="">@(_agent.ProjectId is null ? "None" : "Agent default")</option>
                @foreach (var project in _projects)
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
        </div>

        <RemoteInstancePicker Value="_remoteInstanceId" ValueChanged="v => _remoteInstanceId = v"
                              Hint="For these sessions only. Leave on this machine to follow the agent's own setting." />

        <div class="field">
            <label>First prompt</label>
            <textarea @bind="_prompt" @bind:event="oninput" rows="6" @onkeydown="OnKeyDown"
                      placeholder="Describe the work. Ctrl+Enter to start."></textarea>
        </div>

        <div class="field">
            <label>Instances</label>
            <input type="number" min="1" @bind="_instanceCount" disabled="@_runUntilError" />
        </div>

        <div class="field">
            <label>Seconds between instances</label>
            <input type="number" min="0" @bind="_intervalSeconds" />
        </div>

        <div class="field">
            <label>
                <input type="checkbox" @bind="_runUntilError" />
                Keep starting instances until one fails, then stop
            </label>
        </div>

        @if (_starting && (_instanceCount > 1 || _runUntilError))
        {
            <p class="small mono-dim">Started @_startedCount @(_runUntilError ? "instance(s) so far…" : $"of {_instanceCount}…")</p>
        }

        <div class="btn-row">
            <button class="btn btn-primary" disabled="@(_starting || string.IsNullOrWhiteSpace(_prompt))" @onclick="StartAsync">
                @(_starting ? "Starting…" : "Start session")
            </button>
            <a class="btn btn-ghost" href="/agents">Back</a>
        </div>
    </div>
}

@code {
    [Parameter] public string AgentId { get; set; } = string.Empty;
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private Agent? _agent;
    private IReadOnlyList<Project> _projects = [];
    private string _prompt = string.Empty;
    private string _projectId = string.Empty;

    /// <summary>Overrides where the agent runs, for these sessions only. Null follows the agent.</summary>
    private string? _remoteInstanceId;
    private bool _starting;
    private int _instanceCount = 1;
    private int _intervalSeconds;
    private bool _runUntilError;
    private int _startedCount;

    protected override async Task OnInitializedAsync()
    {
        _agent = await AgentStore.GetAsync(AgentId);
        _projects = await ProjectStore.GetAllAsync();

        // Pre-filled rather than sent behind the scenes: the agent's usual opening is still worth
        // reading and editing before it goes.
        if (_agent is not null && string.IsNullOrWhiteSpace(_prompt))
            _prompt = _agent.DefaultPrompt;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("New session", _agent?.Name);
    }

    private async Task StartAsync()
    {
        if (_agent is null || string.IsNullOrWhiteSpace(_prompt))
            return;

        var agentId = _agent.Id;
        var prompt = _prompt.Trim();
        var projectId = string.IsNullOrWhiteSpace(_projectId) ? null : _projectId;
        var remoteInstanceId = _remoteInstanceId;
        var intervalMs = Math.Max(0, _intervalSeconds) * 1000;
        var untilError = _runUntilError;
        var count = untilError ? int.MaxValue : Math.Max(1, _instanceCount);

        _starting = true;
        _startedCount = 0;
        string? firstSessionId = null;

        try
        {
            for (var i = 0; i < count; i++)
            {
                if (i > 0 && intervalMs > 0)
                    await Task.Delay(intervalMs);

                try
                {
                    var session = await Sessions.StartAsync(new StartSessionRequest
                    {
                        AgentId = agentId,
                        Prompt = prompt,
                        ProjectId = projectId,
                        RemoteInstanceId = remoteInstanceId,
                    });

                    firstSessionId ??= session.Id;
                    _startedCount++;
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    if (untilError)
                    {
                        Layout.Notify($"Stopped after {_startedCount} instance(s): {ex.Message}", "err");
                        break;
                    }

                    throw;
                }
            }

            if (firstSessionId is not null)
                Nav.NavigateTo($"/chat/{firstSessionId}");
        }
        catch (Exception ex)
        {
            Layout.Notify(ex.Message, "err");
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
            await StartAsync();
    }
}
