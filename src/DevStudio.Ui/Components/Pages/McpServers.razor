@page "/mcp-servers"
@inject IEntityStore<McpServer> McpStore
@inject IEntityStore<Agent> AgentStore
@inject IMcpTokenService McpTokens
@inject IMcpProbeService McpProbe
@inject IMcpAuthDiscovery McpAuth
@inject IMcpOAuthService McpOAuth
@inject NavigationManager Nav

<PageTitle>MCP servers · devStudio</PageTitle>

<div class="card" style="margin-bottom:1.2rem">
    <div class="section-tag">This orchestrator is also an MCP server</div>
    <p class="small">
        Agents can call back into the orchestrator at <code>@McpUrl</code> to list sessions, read another
        agent's transcript, leave notes, start sessions and run workflows. Attach the built-in
        <code>orchestrator</code> server below to any agent that should see its colleagues' work.
    </p>
</div>

<div class="btn-row" style="margin-bottom:1.2rem">
    <button class="btn btn-primary" @onclick="() => Edit(new McpServer())">Add MCP server</button>
    <span class="mono-dim">Written to <code>.mcp.json</code> in the session workspace.</span>
</div>

<div class="grid grid-auto">
    @foreach (var server in _servers)
    {
        <div class="card">
            <div class="card-head">
                <h3>@server.Name</h3>
                <div class="spacer"></div>
                <span class="pill @(server.Transport == McpTransport.Stdio ? "pill-cyan" : "pill-magenta")">
                    <span class="dot"></span>@server.Transport
                </span>
            </div>
            <p class="small">@server.Description</p>
            <div class="mono-dim" style="margin-bottom:0.7rem">
                @(server.Transport == McpTransport.Stdio
                    ? $"{server.Command} {string.Join(' ', server.Arguments)}"
                    : server.Url)
            </div>
            <div class="btn-row" style="margin-bottom:0.7rem">
                @if (server.IsBuiltIn)
                {
                    <span class="pill pill-lime">built in</span>
                }
                @if (server.IsDefault)
                {
                    <span class="pill">on every agent</span>
                }
                @if (server.AuthMode != McpAuthMode.None)
                {
                    <span class="pill pill-amber"><span class="dot"></span>@(server.AuthMode == McpAuthMode.ClientCredentials ? "oauth" : "token")</span>
                }
                @if (!server.Enabled)
                {
                    <span class="pill pill-red">disabled</span>
                }
                <span class="pill">@UsageCount(server) agents</span>
            </div>
            @if (_probes.TryGetValue(server.Id, out var probe))
            {
                <div class="@(probe.Succeeded ? "toast ok" : "toast err")" style="margin-bottom:0.7rem">
                    @probe.Detail
                    @if (probe.ServerName is { Length: > 0 })
                    {
                        <span class="mono-dim"> · @probe.ServerName @probe.ServerVersion</span>
                    }
                </div>

                @if (probe.Tools.Count > 0)
                {
                    <div class="table-wrap" style="margin-bottom:0.7rem;max-height:220px;overflow-y:auto">
                        <table class="table">
                            <thead><tr><th>Tool</th><th>What it does</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var tool in probe.Tools)
                            {
                                <tr>
                                    <td><code>@tool.Name</code></td>
                                    <td class="mono-dim">@Shorten(tool.Description)</td>
                                    <td style="text-align:right">
                                        <button class="btn btn-sm" @onclick="() => OpenTool(server, tool)">Run</button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }

            <div class="btn-row">
                <button class="btn btn-sm btn-primary" disabled="@(_probing == server.Id)" @onclick="() => ProbeAsync(server)">
                    @(_probing == server.Id ? "Connecting…" : "Test")
                </button>
                <button class="btn btn-sm" @onclick="() => Edit(server)">Edit</button>
                @if (server.IsBuiltIn)
                {
                    <span class="mono-dim">Built in — cannot be removed</span>
                }
                else
                {
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(server)">Delete</button>
                }
            </div>
        </div>
    }
</div>

@if (_toolServer is not null && _tool is not null)
{
    <div class="modal-backdrop" @onclick="CloseTool">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>@_tool.Name</h2>
            <p class="small">
                Runs on <code>@_toolServer.Name</code> from the orchestrator, with the same URL,
                headers and token an agent would get. A credential that lists tools but cannot use
                them shows up here rather than mid-run.
            </p>

            @if (!string.IsNullOrWhiteSpace(_tool.Description))
            {
                <p class="mono-dim">@_tool.Description</p>
            }

            @if (!string.IsNullOrWhiteSpace(_tool.InputSchema))
            {
                <details style="margin-bottom:0.7rem">
                    <summary class="section-tag" style="cursor:pointer">Input schema</summary>
                    <pre class="mono-dim" style="max-height:180px;overflow:auto">@_tool.InputSchema</pre>
                </details>
            }

            <div class="field">
                <label>Arguments (JSON)</label>
                <textarea rows="6" @bind="_toolArguments" @bind:event="oninput"></textarea>
                <span class="hint">An empty object runs the tool with no arguments.</span>
            </div>

            @if (_toolResult is not null)
            {
                <div class="@(_toolResult.Succeeded ? "toast ok" : "toast err")" style="margin-bottom:0.7rem">
                    @_toolResult.Detail
                </div>

                @if (!string.IsNullOrWhiteSpace(_toolResult.Content))
                {
                    <pre class="mono-dim" style="max-height:260px;overflow:auto">@_toolResult.Content</pre>
                }
            }

            <div class="btn-row">
                <button class="btn btn-primary" disabled="@_toolRunning" @onclick="RunToolAsync">
                    @(_toolRunning ? "Running…" : "Run tool")
                </button>
                <button class="btn btn-ghost" @onclick="CloseTool">Close</button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="() => _editing = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>@(_isNew ? "New MCP server" : _editing.Name)</h2>

            <div class="form-grid">
                <div class="field">
                    <label>Name</label>
                    <input type="text" @bind="_editing.Name" placeholder="github" />
                </div>
                <div class="field">
                    <label>Transport</label>
                    <select @bind="_editing.Transport">
                        <option value="@McpTransport.Stdio">stdio (child process)</option>
                        <option value="@McpTransport.Http">http</option>
                        <option value="@McpTransport.Sse">sse</option>
                    </select>
                </div>
            </div>

            <div class="field">
                <label>Description</label>
                <input type="text" @bind="_editing.Description" />
            </div>

            @if (_editing.Transport == McpTransport.Stdio)
            {
                <div class="form-grid">
                    <div class="field">
                        <label>Command</label>
                        <input type="text" @bind="_editing.Command" placeholder="npx" />
                    </div>
                    <div class="field">
                        <label>Arguments (space separated)</label>
                        <input type="text" value="@string.Join(' ', _editing.Arguments)"
                               @onchange="e => SetArguments(e.Value?.ToString())"
                               placeholder="-y @@modelcontextprotocol/server-github" />
                    </div>
                </div>
            }
            else
            {
                <div class="field">
                    <label>URL</label>
                    <input type="url" @bind="_editing.Url" placeholder="https://example.com/mcp" />
                    <div class="btn-row" style="margin-top:0.5rem">
                        <button class="btn btn-sm" disabled="@_discovering" @onclick="DiscoverAsync">
                            @(_discovering ? "Asking…" : "Discover auth")
                        </button>
                        <span class="hint">Asks the endpoint how it wants to be authenticated and fills in what it says.</span>
                    </div>
                </div>
            }

            @if (_editing.Transport != McpTransport.Stdio)
            {
                <div class="divider"></div>
                <div class="section-tag">Authentication</div>

                <div class="field">
                    <label>Mode</label>
                    <select @bind="_editing.AuthMode">
                        <option value="@McpAuthMode.None">None — or static headers below</option>
                        <option value="@McpAuthMode.OAuth">OAuth sign-in (browser)</option>
                        <option value="@McpAuthMode.ClientCredentials">OAuth client credentials</option>
                        <option value="@McpAuthMode.BearerToken">Bearer token I paste in</option>
                    </select>
                    <span class="hint">
                        Client credentials is for servers that authenticate as a service. Hosted servers
                        such as Atlassian's Rovo issue no service tokens at all — those need the sign-in,
                        which is done once here and then renewed on its own.
                    </span>
                </div>

                @if (_discovery is { } found)
                {
                    <div class="card" style="margin-bottom:0.8rem">
                        <div class="card-head">
                            <h3 style="font-size:0.9rem">What the endpoint says</h3>
                            <div class="spacer"></div>
                            @if (!found.Succeeded)
                            {
                                <span class="pill pill-red">incomplete</span>
                            }
                            else if (found.SupportsClientCredentials)
                            {
                                <span class="pill pill-lime">client credentials</span>
                            }
                            else if (found.RequiresAuth)
                            {
                                <span class="pill pill-amber">browser sign-in</span>
                            }
                            else
                            {
                                <span class="pill pill-lime">no auth needed</span>
                            }
                        </div>

                        <p class="small">@found.Detail</p>

                        @if (found.Issuer is { Length: > 0 })
                        {
                            <dl class="kv">
                                <dt>Issuer</dt><dd class="mono-dim">@found.Issuer</dd>
                                @if (found.TokenUrl is { Length: > 0 })
                                {
                                    <dt>Token endpoint</dt><dd class="mono-dim">@found.TokenUrl</dd>
                                }
                                @if (found.RegistrationUrl is { Length: > 0 })
                                {
                                    <dt>Registration</dt><dd class="mono-dim">@found.RegistrationUrl</dd>
                                }
                                @if (found.Scopes is { Count: > 0 })
                                {
                                    <dt>Scopes offered</dt><dd class="mono-dim">@string.Join(" ", found.Scopes)</dd>
                                }
                            </dl>
                        }

                        @if (found.TokenUrl is { Length: > 0 })
                        {
                            <div class="btn-row" style="margin-top:0.6rem">
                                <button class="btn btn-sm" @onclick="() => ApplyDiscovery(found)">Fill the fields in</button>
                                <span class="hint">Sets the mode, token URL and scopes. You still supply the client id and secret.</span>
                            </div>
                        }
                    </div>
                }

                @if (_editing.AuthMode == McpAuthMode.OAuth)
                {
                    <div class="field">
                        <label>Authorization URL</label>
                        <input type="url" @bind="_editing.AuthorizationUrl" placeholder="https://issuer.example.com/authorize" />
                        <span class="hint">Left blank, this is discovered from the endpoint when you sign in.</span>
                    </div>
                    <div class="field">
                        <label>Token URL</label>
                        <input type="url" @bind="_editing.TokenUrl" placeholder="https://issuer.example.com/oauth/token" />
                    </div>
                    <div class="form-grid">
                        <div class="field">
                            <label>Client id</label>
                            <input type="text" @bind="_editing.ClientId" />
                            <span class="hint">Left blank, this app registers itself if the issuer allows it.</span>
                        </div>
                        <div class="field">
                            <label>Scopes</label>
                            <input type="text" @bind="_editing.Scopes" placeholder="read:jira-work offline_access" />
                        </div>
                    </div>

                    <div class="btn-row" style="margin-bottom:0.6rem">
                        <button class="btn btn-primary btn-sm" disabled="@_signingIn" @onclick="SignInAsync">
                            @(_signingIn ? "Starting…" : _editing.AuthorizedAt is null ? "Sign in" : "Sign in again")
                        </button>
                        @if (_editing.AuthorizedAt is { } signedInAt)
                        {
                            <span class="pill pill-lime">signed in @signedInAt.ToLocalTime().ToString("d MMM HH:mm")</span>
                            <button class="btn btn-ghost btn-sm" @onclick="SignOutAsync">Sign out</button>
                        }
                        else
                        {
                            <span class="hint">Saves the server, then sends you to the provider to authorise it.</span>
                        }
                    </div>
                }
                else if (_editing.AuthMode == McpAuthMode.ClientCredentials)
                {
                    <div class="field">
                        <label>Token URL</label>
                        <input type="url" @bind="_editing.TokenUrl" placeholder="https://issuer.example.com/oauth/token" />
                    </div>
                    <div class="form-grid">
                        <div class="field">
                            <label>Client id</label>
                            <input type="text" @bind="_editing.ClientId" />
                        </div>
                        <div class="field">
                            <label>Client secret</label>
                            <input type="password" @bind="_editing.ClientSecret" />
                            <span class="hint">Stored on the data volume — treat that volume as secret.</span>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="field">
                            <label>Scopes</label>
                            <input type="text" @bind="_editing.Scopes" placeholder="mcp:read mcp:invoke" />
                        </div>
                        <div class="field">
                            <label>Audience (optional)</label>
                            <input type="text" @bind="_editing.Audience" />
                        </div>
                    </div>
                }
                else if (_editing.AuthMode == McpAuthMode.BearerToken)
                {
                    <div class="field">
                        <label>Token</label>
                        <input type="password" @bind="_editing.AccessToken" />
                    </div>
                }

                @if (_editing.AuthMode != McpAuthMode.None)
                {
                    <div class="form-grid">
                        <div class="field">
                            <label>Header name</label>
                            <input type="text" @bind="_editing.AuthHeaderName" placeholder="Authorization" />
                        </div>
                        <div class="field">
                            <label>Prefix</label>
                            <input type="text" @bind="_editing.AuthHeaderPrefix" placeholder="Bearer" />
                        </div>
                    </div>

                    <div class="btn-row" style="margin-bottom:0.6rem">
                        <button class="btn btn-sm" @onclick="TestTokenAsync">Test token</button>
                        @if (!string.IsNullOrWhiteSpace(_tokenStatus))
                        {
                            <span class="mono-dim">@_tokenStatus</span>
                        }
                    </div>
                }
            }

            <div class="field">
                <label>Environment / headers (KEY=value per line)</label>
                <textarea rows="4" value="@PairsText"
                          @onchange="e => SetPairs(e.Value?.ToString())"></textarea>
            </div>

            <div class="check">
                <input type="checkbox" id="mcp-default" @bind="_editing.IsDefault" />
                <label for="mcp-default" style="text-transform:none;letter-spacing:0">Attach to every agent automatically</label>
            </div>
            <div class="check">
                <input type="checkbox" id="mcp-enabled" @bind="_editing.Enabled" />
                <label for="mcp-enabled" style="text-transform:none;letter-spacing:0">Enabled</label>
            </div>

            <div class="btn-row">
                <button class="btn btn-primary" @onclick="SaveAsync">Save server</button>
                <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<McpServer> _servers = [];
    private IReadOnlyList<Agent> _agents = [];
    private McpServer? _editing;
    private bool _isNew;
    private string _tokenStatus = string.Empty;
    private McpAuthDiscovery? _discovery;
    private bool _discovering;
    private bool _signingIn;
    private readonly Dictionary<string, McpProbeResult> _probes = [];
    private string? _probing;

    private McpServer? _toolServer;
    private McpToolInfo? _tool;
    private string _toolArguments = "{}";
    private McpToolCallResult? _toolResult;
    private bool _toolRunning;

    private string McpUrl => Nav.BaseUri.TrimEnd('/') + "/mcp";

    private string PairsText => string.Join('\n', (_editing!.Transport == McpTransport.Stdio
            ? _editing.Environment
            : _editing.Headers)
        .Select(p => $"{p.Key}={p.Value}"));

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("MCP servers", "Tools your agents can reach — and the orchestrator's own server");
    }

    private async Task ReloadAsync()
    {
        _servers = await McpStore.GetAllAsync();
        _agents = await AgentStore.GetAllAsync();
    }

    private void Edit(McpServer server)
    {
        _isNew = _servers.All(s => s.Id != server.Id);
        _editing = _isNew ? server : Clone(server);
        _tokenStatus = string.Empty;
        _discovery = null;
    }

    /// <summary>
    /// Asks the endpoint how it authenticates rather than making the operator hunt through the
    /// vendor's docs for an issuer and a token URL.
    /// </summary>
    private async Task DiscoverAsync()
    {
        if (_editing is null)
            return;

        _discovering = true;
        _discovery = null;
        try
        {
            _discovery = await McpAuth.DiscoverAsync(_editing.Url);
        }
        finally
        {
            _discovering = false;
        }
    }

    /// <summary>
    /// Writes the discovered issuer onto the record. The client id and secret are deliberately left
    /// alone: those come from registering with the issuer, which is not something discovery can do.
    /// </summary>
    private void ApplyDiscovery(McpAuthDiscovery found)
    {
        if (_editing is null || found.TokenUrl is not { Length: > 0 })
            return;

        // A server that offers no service grant can only be reached by signing in, so land on the mode
        // that will actually work rather than one that is guaranteed to be refused.
        _editing.AuthMode = found.SupportsClientCredentials
            ? McpAuthMode.ClientCredentials
            : McpAuthMode.OAuth;

        _editing.TokenUrl = found.TokenUrl;

        if (found.AuthorizationUrl is { Length: > 0 } authorize)
            _editing.AuthorizationUrl = authorize;

        if (found.RegistrationUrl is { Length: > 0 } register)
            _editing.RegistrationUrl = register;

        if (string.IsNullOrWhiteSpace(_editing.Scopes) && found.ScopeString is { Length: > 0 } scopes)
            _editing.Scopes = scopes;

        if (string.IsNullOrWhiteSpace(_editing.Audience) && found.Resource is { Length: > 0 } resource)
            _editing.Audience = resource;

        Layout.Notify(found.SupportsClientCredentials
            ? "Filled in. Add the client id and secret, then test the token."
            : "Filled in. This issuer needs a browser sign-in — press Sign in.");
    }

    /// <summary>Connects like a CLI would and reports what the server actually offers.</summary>
    private async Task ProbeAsync(McpServer server)
    {
        _probing = server.Id;
        try
        {
            _probes[server.Id] = await McpProbe.ListToolsAsync(server);
        }
        finally
        {
            _probing = null;
        }
    }

    private void OpenTool(McpServer server, McpToolInfo tool)
    {
        _toolServer = server;
        _tool = tool;
        _toolArguments = "{}";
        _toolResult = null;
    }

    private void CloseTool()
    {
        _toolServer = null;
        _tool = null;
        _toolResult = null;
    }

    /// <summary>Runs one tool for real — the only check that covers everything an agent needs.</summary>
    private async Task RunToolAsync()
    {
        if (_toolServer is null || _tool is null)
            return;

        _toolRunning = true;
        _toolResult = null;
        try
        {
            _toolResult = await McpProbe.CallToolAsync(_toolServer, _tool.Name, _toolArguments);
        }
        finally
        {
            _toolRunning = false;
        }

        Layout.Notify(_toolResult.Detail, _toolResult.Succeeded ? "ok" : "err");
    }

    private static string Shorten(string text)
    {
        var single = text.ReplaceLineEndings(" ").Trim();
        return single.Length <= 120 ? single : single[..117] + "...";
    }

    private async Task TestTokenAsync()
    {
        if (_editing is null)
            return;

        var result = await McpTokens.TestAsync(_editing);
        _tokenStatus = result.Detail;
        Layout.Notify(result.Detail, result.Succeeded ? "ok" : "err");
    }

    /// <summary>
    /// Saves, then hands the browser to the issuer. Saving first is not a convenience: the callback
    /// arrives on a different request and finds the server by id, so an unsaved record has nowhere
    /// for the tokens to land.
    /// </summary>
    private async Task SignInAsync()
    {
        if (_editing is null)
            return;

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            Layout.Notify("An MCP server needs a name before it can be signed in to.", "err");
            return;
        }

        _signingIn = true;
        try
        {
            await McpStore.UpsertAsync(_editing);

            var redirectUri = Nav.BaseUri.TrimEnd('/') + "/mcp/oauth/callback";
            var start = await McpOAuth.BeginAsync(_editing, redirectUri);

            if (!start.Succeeded || start.AuthorizationUrl is not { Length: > 0 } url)
            {
                Layout.Notify(start.Detail, "err");
                return;
            }

            // Leaves the circuit behind, which is fine — the callback page links back here.
            Nav.NavigateTo(url, forceLoad: true);
        }
        finally
        {
            _signingIn = false;
        }
    }

    private async Task SignOutAsync()
    {
        if (_editing is null)
            return;

        await McpOAuth.SignOutAsync(_editing);
        await ReloadAsync();
        Layout.Notify("Signed out. The server will need authorising again before it can be used.", "ok");
    }

    private async Task SaveAsync()
    {
        if (_editing is null)
            return;

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            Layout.Notify("An MCP server needs a name.", "err");
            return;
        }

        await McpStore.UpsertAsync(_editing);
        _editing = null;
        await ReloadAsync();
        Layout.Notify("MCP server saved.", "ok");
    }

    private async Task DeleteAsync(McpServer server)
    {
        if (server.IsBuiltIn)
        {
            Layout.Notify("The orchestrator's own server cannot be deleted.", "err");
            return;
        }

        await McpStore.DeleteAsync(server.Id);
        await ReloadAsync();
    }

    private void SetArguments(string? value) =>
        _editing!.Arguments = (value ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

    private void SetPairs(string? value)
    {
        var pairs = new Dictionary<string, string>();
        foreach (var line in (value ?? string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var separator = line.IndexOf('=');
            if (separator > 0)
                pairs[line[..separator].Trim()] = line[(separator + 1)..].Trim();
        }

        if (_editing!.Transport == McpTransport.Stdio)
            _editing.Environment = pairs;
        else
            _editing.Headers = pairs;
    }

    private int UsageCount(McpServer server) =>
        server.IsDefault ? _agents.Count : _agents.Count(a => a.McpServerIds.Contains(server.Id));

    private static McpServer Clone(McpServer server) => new()
    {
        Id = server.Id,
        CreatedAt = server.CreatedAt,
        Name = server.Name,
        Description = server.Description,
        Transport = server.Transport,
        Command = server.Command,
        Arguments = [.. server.Arguments],
        Url = server.Url,
        Environment = new Dictionary<string, string>(server.Environment),
        Headers = new Dictionary<string, string>(server.Headers),
        AuthMode = server.AuthMode,
        TokenUrl = server.TokenUrl,
        ClientId = server.ClientId,
        ClientSecret = server.ClientSecret,
        Scopes = server.Scopes,
        Audience = server.Audience,
        AuthorizationUrl = server.AuthorizationUrl,
        RegistrationUrl = server.RegistrationUrl,
        AccessToken = server.AccessToken,
        AccessTokenExpiresAt = server.AccessTokenExpiresAt,
        RefreshToken = server.RefreshToken,
        AuthorizedAccount = server.AuthorizedAccount,
        AuthorizedAt = server.AuthorizedAt,
        AuthHeaderName = server.AuthHeaderName,
        AuthHeaderPrefix = server.AuthHeaderPrefix,
        Enabled = server.Enabled,
        IsDefault = server.IsDefault,
        IsBuiltIn = server.IsBuiltIn,
    };
}
