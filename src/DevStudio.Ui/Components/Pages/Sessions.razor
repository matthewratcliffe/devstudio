@page "/sessions"
@implements IDisposable
@inject ISessionManager SessionManager
@inject IEntityStore<ChatSession> SessionStore
@inject IEntityStore<Project> ProjectStore
@inject NavigationManager Nav

<PageTitle>Sessions · devStudio</PageTitle>

<div class="tabs">
    <button class="tab @(_filter == "live" ? "active" : "")" @onclick='() => SetFilter("live")'>Live</button>
    <button class="tab @(_filter == "failed" ? "active" : "")" @onclick='() => SetFilter("failed")'>Failed</button>
    <button class="tab @(_filter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>All</button>
    <button class="tab @(_filter == "archived" ? "active" : "")" @onclick='() => SetFilter("archived")'>Archive</button>
    <div style="flex:1"></div>
    @if (_selected.Count > 0)
    {
        <span class="mono-dim">@_selected.Count selected</span>
        <select class="select-sm" @key="_bulkStatusKey" value="" @onchange="SetStatusOnSelectedAsync">
            <option value="">Set status…</option>
            @foreach (var status in BulkStatuses)
            {
                <option value="@status">@status</option>
            }
        </select>
        @if (_filter == "archived")
        {
            <button class="btn btn-sm" @onclick="RestoreSelectedAsync">Restore</button>
        }
        else
        {
            <button class="btn btn-sm" @onclick="ArchiveSelectedAsync">Archive</button>
        }
        <button class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Delete</button>
        <button class="btn btn-sm btn-ghost" @onclick="ClearSelection">Clear</button>
    }
</div>

@if (_visible.Count == 0)
{
    <div class="empty">
        <div class="big">▤</div>
        No sessions here.
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th style="width:2rem">
                    <input type="checkbox" title="Select all"
                           checked="@AllVisibleSelected" @onchange="ToggleSelectAll" />
                </th>
                <th>Title</th>
                <th>Agent</th>
                <th>Project</th>
                <th>Status</th>
                <th>Trigger</th>
                <th>Updated</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var session in _visible)
            {
                <tr>
                    <td>
                        <input type="checkbox" checked="@_selected.Contains(session.Id)"
                               @onchange="e => ToggleSelected(session.Id, e)" />
                    </td>
                    <td style="cursor:pointer" @onclick="() => Open(session)">@session.Title</td>
                    <td class="mono-dim">@session.AgentName · @session.Provider</td>
                    <td class="mono-dim">@ProjectName(session.ProjectId)</td>
                    <td><StatusPill Session="session.Status" /></td>
                    <td class="mono-dim">@session.Trigger</td>
                    <td class="mono-dim"><LocalTime Value="@session.UpdatedAt" Format="daytime" /></td>
                    <td>
                        <div class="btn-row">
                            <a class="btn btn-sm" href="/chat/@session.Id">Open</a>
                            @if (session.IsLive)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => StopAsync(session)">Stop</button>
                            }
                            else if (session.IsArchived)
                            {
                                <button class="btn btn-sm" @onclick="() => RestoreAsync(session)">Restore</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-ghost" @onclick="() => ArchiveAsync(session)">Archive</button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<ChatSession> _all = [];
    private IReadOnlyList<Project> _projects = [];
    private List<ChatSession> _visible = [];
    private readonly HashSet<string> _selected = [];
    private readonly RenderCoalescer _render = new();
    private string _filter = "live";

    /// <summary>
    /// Bumped after each bulk status change so the picker is rebuilt on its placeholder. Setting the
    /// bound value back to empty is not enough on its own: the value Blazor last rendered was empty
    /// too, so the diff sees no change and leaves the browser showing the option just used.
    /// </summary>
    private int _bulkStatusKey;

    /// <summary>
    /// Statuses worth forcing by hand. The transient ones a run passes through on its way somewhere
    /// — Starting, Running, AwaitingInput — are left out: setting them would claim a process exists
    /// when the point of this control is to settle sessions whose process is gone.
    /// </summary>
    private static readonly SessionStatus[] BulkStatuses =
    [
        SessionStatus.Completed,
        SessionStatus.Failed,
        SessionStatus.Cancelled,
        SessionStatus.Pending,
    ];

    private bool AllVisibleSelected => _visible.Count > 0 && _visible.All(s => _selected.Contains(s.Id));

    protected override async Task OnInitializedAsync()
    {
        SessionManager.SessionUpdated += OnSessionUpdated;
        _projects = await ProjectStore.GetAllAsync();
        await ReloadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Sessions", "Every conversation, live and finished");
    }

    private void Open(ChatSession session) => Nav.NavigateTo($"/chat/{session.Id}");

    private async Task ReloadAsync()
    {
        _all = await SessionManager.GetAllAsync();
        ApplyFilter();
    }

    private void SetFilter(string filter)
    {
        _filter = filter;
        // Selection is per view: acting on rows the operator can no longer see is how a bulk delete
        // takes something nobody meant to touch.
        ClearSelection();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _visible = _filter switch
        {
            "live" => _all.Where(s => s.IsLive && !s.IsArchived).ToList(),
            "failed" => _all.Where(s => s.Status == SessionStatus.Failed && !s.IsArchived).ToList(),
            "archived" => _all.Where(s => s.IsArchived).ToList(),
            _ => _all.Where(s => !s.IsArchived).ToList(),
        };
    }

    private void ToggleSelected(string id, ChangeEventArgs args)
    {
        if (args.Value is true)
            _selected.Add(id);
        else
            _selected.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            foreach (var session in _visible)
                _selected.Add(session.Id);
        }
        else
        {
            ClearSelection();
        }
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _bulkStatusKey++;
    }

    private List<ChatSession> SelectedSessions() =>
        _all.Where(s => _selected.Contains(s.Id)).ToList();

    private async Task SetStatusOnSelectedAsync(ChangeEventArgs args)
    {
        // The picker is an action, not a setting: it goes back to its placeholder either way so the
        // same status can be applied again to a different selection.
        _bulkStatusKey++;

        if (args.Value?.ToString() is not { Length: > 0 } value
            || !Enum.TryParse<SessionStatus>(value, out var status))
            return;

        var sessions = SelectedSessions();
        var live = sessions.Count(s => s.IsLive);

        foreach (var session in sessions)
            await SessionManager.SetStatusAsync(session.Id, status);

        Layout.Notify(
            live > 0
                ? $"Set {sessions.Count} sessions to {status}, stopping {live} that were running."
                : $"Set {sessions.Count} sessions to {status}.",
            "ok");

        ClearSelection();
        await ReloadAsync();
    }

    private async Task ArchiveSelectedAsync()
    {
        var sessions = SelectedSessions();

        foreach (var session in sessions)
            await ArchiveAsync(session, reload: false);

        Layout.Notify($"Archived {sessions.Count} sessions.", "ok");
        ClearSelection();
        await ReloadAsync();
    }

    private async Task RestoreSelectedAsync()
    {
        var sessions = SelectedSessions();

        foreach (var session in sessions)
            await RestoreAsync(session, reload: false);

        Layout.Notify($"Restored {sessions.Count} sessions.", "ok");
        ClearSelection();
        await ReloadAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        var count = _selected.Count;

        foreach (var id in _selected.ToList())
            await SessionManager.DeleteAsync(id);

        Layout.Notify($"Deleted {count} sessions.", "ok");
        ClearSelection();
        await ReloadAsync();
    }

    private async Task StopAsync(ChatSession session)
    {
        await SessionManager.CancelAsync(session.Id);
        Layout.Notify("Stopping.");
    }

    private async Task ArchiveAsync(ChatSession session, bool reload = true)
    {
        session.IsArchived = true;
        await SessionStore.UpsertAsync(session);

        if (reload)
            await ReloadAsync();
    }

    private async Task RestoreAsync(ChatSession session, bool reload = true)
    {
        session.IsArchived = false;
        // Taking it back out by hand settles the question for good: the age sweep leaves it alone
        // from here, however long it then sits in the list.
        session.AutoArchiveExempt = true;
        await SessionStore.UpsertAsync(session);

        if (reload)
            await ReloadAsync();
    }

    private string ProjectName(string? projectId) =>
        projectId is null ? "—" : _projects.FirstOrDefault(p => p.Id == projectId)?.Name ?? "—";

    // Collapsed for the same reason as the dashboard: a streaming turn raises this far faster
    // than the list can be rebuilt from the store.
    private void OnSessionUpdated(ChatSession session) => _render.Queue(() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    }));

    public void Dispose() => SessionManager.SessionUpdated -= OnSessionUpdated;
}
