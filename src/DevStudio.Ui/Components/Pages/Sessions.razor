@page "/sessions"
@implements IDisposable
@inject ISessionManager SessionManager
@inject IEntityStore<ChatSession> SessionStore
@inject IEntityStore<Project> ProjectStore
@inject NavigationManager Nav

<PageTitle>Sessions · devStudio</PageTitle>

<div class="tabs">
    <button class="tab @(_filter == "live" ? "active" : "")" @onclick='() => SetFilter("live")'>Live</button>
    <button class="tab @(_filter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>All</button>
    <button class="tab @(_filter == "failed" ? "active" : "")" @onclick='() => SetFilter("failed")'>Failed</button>
    <button class="tab @(_filter == "archived" ? "active" : "")" @onclick='() => SetFilter("archived")'>Archive</button>
    <div style="flex:1"></div>
    @if (_selected.Count > 0)
    {
        <button class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Delete @_selected.Count selected</button>
        <button class="btn btn-sm btn-ghost" @onclick="() => _selected.Clear()">Clear</button>
    }
</div>

@if (_visible.Count == 0)
{
    <div class="empty">
        <div class="big">▤</div>
        No sessions here.
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th style="width:2rem"></th>
                <th>Title</th>
                <th>Agent</th>
                <th>Project</th>
                <th>Status</th>
                <th>Trigger</th>
                <th>Updated</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var session in _visible)
            {
                <tr>
                    <td>
                        <input type="checkbox" checked="@_selected.Contains(session.Id)"
                               @onchange="e => ToggleSelected(session.Id, e)" />
                    </td>
                    <td style="cursor:pointer" @onclick="() => Open(session)">@session.Title</td>
                    <td class="mono-dim">@session.AgentName · @session.Provider</td>
                    <td class="mono-dim">@ProjectName(session.ProjectId)</td>
                    <td><StatusPill Session="session.Status" /></td>
                    <td class="mono-dim">@session.Trigger</td>
                    <td class="mono-dim"><LocalTime Value="@session.UpdatedAt" Format="daytime" /></td>
                    <td>
                        <div class="btn-row">
                            <a class="btn btn-sm" href="/chat/@session.Id">Open</a>
                            @if (session.IsLive)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => StopAsync(session)">Stop</button>
                            }
                            else if (session.IsArchived)
                            {
                                <button class="btn btn-sm" @onclick="() => RestoreAsync(session)">Restore</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-ghost" @onclick="() => ArchiveAsync(session)">Archive</button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private IReadOnlyList<ChatSession> _all = [];
    private IReadOnlyList<Project> _projects = [];
    private List<ChatSession> _visible = [];
    private readonly HashSet<string> _selected = [];
    private readonly RenderCoalescer _render = new();
    private string _filter = "all";

    protected override async Task OnInitializedAsync()
    {
        SessionManager.SessionUpdated += OnSessionUpdated;
        _projects = await ProjectStore.GetAllAsync();
        await ReloadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader("Sessions", "Every conversation, live and finished");
    }

    private void Open(ChatSession session) => Nav.NavigateTo($"/chat/{session.Id}");

    private async Task ReloadAsync()
    {
        _all = await SessionManager.GetAllAsync();
        ApplyFilter();
    }

    private void SetFilter(string filter)
    {
        _filter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _visible = _filter switch
        {
            "live" => _all.Where(s => s.IsLive && !s.IsArchived).ToList(),
            "failed" => _all.Where(s => s.Status == SessionStatus.Failed && !s.IsArchived).ToList(),
            "archived" => _all.Where(s => s.IsArchived).ToList(),
            _ => _all.Where(s => !s.IsArchived).ToList(),
        };
    }

    private void ToggleSelected(string id, ChangeEventArgs args)
    {
        if (args.Value is true)
            _selected.Add(id);
        else
            _selected.Remove(id);
    }

    private async Task DeleteSelectedAsync()
    {
        foreach (var id in _selected.ToList())
            await SessionManager.DeleteAsync(id);

        Layout.Notify($"Deleted {_selected.Count} sessions.", "ok");
        _selected.Clear();
        await ReloadAsync();
    }

    private async Task StopAsync(ChatSession session)
    {
        await SessionManager.CancelAsync(session.Id);
        Layout.Notify("Stopping.");
    }

    private async Task ArchiveAsync(ChatSession session)
    {
        session.IsArchived = true;
        await SessionStore.UpsertAsync(session);
        await ReloadAsync();
    }

    private async Task RestoreAsync(ChatSession session)
    {
        session.IsArchived = false;
        await SessionStore.UpsertAsync(session);
        await ReloadAsync();
    }

    private string ProjectName(string? projectId) =>
        projectId is null ? "—" : _projects.FirstOrDefault(p => p.Id == projectId)?.Name ?? "—";

    // Collapsed for the same reason as the dashboard: a streaming turn raises this far faster
    // than the list can be rebuilt from the store.
    private void OnSessionUpdated(ChatSession session) => _render.Queue(() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    }));

    public void Dispose() => SessionManager.SessionUpdated -= OnSessionUpdated;
}
