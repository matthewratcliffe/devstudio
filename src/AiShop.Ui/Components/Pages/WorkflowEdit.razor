@page "/workflows/{WorkflowId}/edit"
@inject IEntityStore<Workflow> WorkflowStore
@inject IEntityStore<Agent> AgentStore
@inject IEntityStore<Project> ProjectStore
@inject NavigationManager Nav

<PageTitle>Edit workflow · AI Shop</PageTitle>

@if (_workflow is null)
{
    <div class="empty">That workflow no longer exists.</div>
}
else
{
    <div class="card" style="margin-bottom:1.2rem">
        <div class="form-grid">
            <div class="field">
                <label>Name</label>
                <input type="text" @bind="_workflow.Name" />
            </div>
            <div class="field">
                <label>Default project</label>
                <select @bind="_workflow.ProjectId">
                    <option value="">None</option>
                    @foreach (var project in _projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="field">
            <label>Description</label>
            <input type="text" @bind="_workflow.Description" />
        </div>
        <div class="check">
            <input type="checkbox" id="wf-enabled" @bind="_workflow.Enabled" />
            <label for="wf-enabled" style="text-transform:none;letter-spacing:0">Enabled</label>
        </div>
    </div>

    <div class="card" style="margin-bottom:1.2rem">
        <div class="card-head">
            <h3>Inputs</h3>
            <div class="spacer"></div>
            <button class="btn btn-sm" @onclick="AddInput">Add input</button>
        </div>
        <p class="small">Supplied when the run starts. Reference them in any step as <code>{{name}}</code>.</p>

        @foreach (var input in _workflow.Inputs)
        {
            <div class="form-grid" style="align-items:end">
                <div class="field">
                    <label>Name</label>
                    <input type="text" @bind="input.Name" />
                </div>
                <div class="field">
                    <label>Description</label>
                    <input type="text" @bind="input.Description" />
                </div>
                <div class="field">
                    <label>Default</label>
                    <input type="text" @bind="input.DefaultValue" />
                </div>
                <div class="field">
                    <div class="check">
                        <input type="checkbox" @bind="input.Required" />
                        <span>Required</span>
                    </div>
                    <button class="btn btn-sm btn-danger" @onclick="() => _workflow.Inputs.Remove(input)">Remove</button>
                </div>
            </div>
        }
    </div>

    <div class="card-head">
        <h3>Steps</h3>
        <div class="spacer"></div>
        <button class="btn btn-sm btn-primary" @onclick="AddStep">Add step</button>
    </div>

    <p class="small">
        Available in every prompt: <code>{{previous}}</code> for the step just finished,
        <code>{{steps.step-name}}</code> for any earlier step (slugified name), and every workflow input.
    </p>

    @foreach (var step in _workflow.Steps.OrderBy(s => s.Order).ToList())
    {
        <div class="card" style="margin-bottom:0.9rem">
            <div class="form-grid">
                <div class="field">
                    <label>Step name</label>
                    <input type="text" @bind="step.Name" />
                    <span class="hint">Referenced as <code>{{steps.@TemplateRenderer.Slugify(step.Name)}}</code></span>
                </div>
                <div class="field">
                    <label>Agent</label>
                    <select @bind="step.AgentId">
                        <option value="">Pick an agent</option>
                        @foreach (var agent in _agents)
                        {
                            <option value="@agent.Id">@agent.Name — @agent.Provider</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label>Order</label>
                    <input type="number" @bind="step.Order" />
                    <span class="hint">Same order = runs concurrently.</span>
                </div>
                <div class="field">
                    <label>Timeout (minutes)</label>
                    <input type="number" @bind="step.TimeoutMinutes" />
                </div>
            </div>

            <div class="field">
                <label>Prompt</label>
                <textarea rows="5" @bind="step.PromptTemplate"></textarea>
            </div>

            <div class="check">
                <input type="checkbox" @bind="step.ReuseWorkspace" />
                <span>Reuse the previous step's working directory</span>
            </div>
            <div class="check">
                <input type="checkbox" @bind="step.ContinueOnError" />
                <span>Carry on if this step fails</span>
            </div>

            <div class="btn-row">
                <button class="btn btn-sm btn-danger" @onclick="() => _workflow.Steps.Remove(step)">Remove step</button>
            </div>
        </div>
    }

    <div class="btn-row" style="margin-top:1.2rem">
        <button class="btn btn-primary" @onclick="SaveAsync">Save workflow</button>
        <a class="btn btn-ghost" href="/workflows">Back</a>
    </div>
}

@code {
    [Parameter] public string WorkflowId { get; set; } = string.Empty;
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private Workflow? _workflow;
    private IReadOnlyList<Agent> _agents = [];
    private IReadOnlyList<Project> _projects = [];

    protected override async Task OnInitializedAsync()
    {
        _workflow = await WorkflowStore.GetAsync(WorkflowId);
        _agents = await AgentStore.GetAllAsync();
        _projects = await ProjectStore.GetAllAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Layout.SetHeader(_workflow?.Name ?? "Workflow", "Step editor");
    }

    private void AddInput() => _workflow!.Inputs.Add(new WorkflowInput { Name = $"input{_workflow.Inputs.Count + 1}" });

    private void AddStep() => _workflow!.Steps.Add(new WorkflowStep
    {
        Name = $"Step {_workflow.Steps.Count + 1}",
        Order = _workflow.Steps.Count == 0 ? 1 : _workflow.Steps.Max(s => s.Order) + 1,
        AgentId = _agents.FirstOrDefault()?.Id ?? string.Empty,
    });

    private async Task SaveAsync()
    {
        if (_workflow is null)
            return;

        if (_workflow.Steps.Any(s => string.IsNullOrWhiteSpace(s.AgentId)))
        {
            Layout.Notify("Every step needs an agent.", "err");
            return;
        }

        _workflow.ProjectId = string.IsNullOrWhiteSpace(_workflow.ProjectId) ? null : _workflow.ProjectId;
        await WorkflowStore.UpsertAsync(_workflow);
        Layout.Notify("Workflow saved.", "ok");
        Nav.NavigateTo("/workflows");
    }
}
